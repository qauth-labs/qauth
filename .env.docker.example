# QAuth Docker Environment Variables
# Copy this file to .env and fill in the required values

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL connection is automatically configured by docker-compose
# DATABASE_URL is set automatically based on DB_PASSWORD below
DB_PASSWORD=qauth_dev_password

# Database Pool Configuration (optional)
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# =============================================================================
# Redis Configuration
# =============================================================================
# Redis connection is automatically configured by docker-compose
# REDIS_URL is set automatically
# Optional: Set a password for Redis (leave empty for no password)
REDIS_PASSWORD=

# Redis database number (0-15)
REDIS_DB=0

# Redis Connection Pool Configuration (optional)
REDIS_MAX_RETRIES=3
REDIS_CONNECTION_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

# =============================================================================
# JWT Configuration (REQUIRED)
# =============================================================================
# Generate EdDSA key pair for JWT signing:
#
#   openssl genpkey -algorithm Ed25519 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
#
# Then set the keys below (optional: tokens are signed with the realm's keys
# in the key store, which imports these at the first boot; leave them unset and
# that boot generates the keys). You can either:
# 1. Use environment variables (paste the full key including BEGIN/END lines)
# 2. Use file paths (set JWT_PRIVATE_KEY_PATH and JWT_PUBLIC_KEY_PATH)

# Option 1: Environment Variables (paste full key including BEGIN/END lines)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MC4CAQAwBQYDK2VwBCIEI...
-----END PRIVATE KEY-----"

JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEA...
-----END PUBLIC KEY-----"

# Option 2: File Paths (alternative to environment variables)
# JWT_PRIVATE_KEY_PATH=/path/to/private.pem
# JWT_PUBLIC_KEY_PATH=/path/to/public.pem

# Key-encryption key (KEK, required). It wraps every key in the realm key store:
# at the first boot the server imports JWT_PRIVATE_KEY and SESSION_COOKIE_SECRET,
# when set, into it, and refuses without a KEK. Keep a copy with your backups; without it
# the stored keys cannot be read.
# Generate with: openssl rand -base64 32
KEK=
# Or a file holding it, readable by its owner only (wins over KEK). The path is
# read inside the container, so mount the file there (docker-compose.yml shows
# a Compose secret):
# KEK_PATH=/run/secrets/qauth_kek

# JWT issuer URL (required). With DEFAULT_REALM_NAME, the single-realm setting:
# at first boot it becomes the default realm's permanent issuer, and its host the
# realm's primary host. No trailing slash; https, or plain http on localhost.
JWT_ISSUER=http://localhost:3000

# Token expiration (optional, defaults shown). They seed a new realm; an
# existing realm keeps its own lifetimes.
ACCESS_TOKEN_LIFESPAN=900
REFRESH_TOKEN_LIFESPAN=604800

# =============================================================================
# Server Configuration
# =============================================================================
NODE_ENV=production
LOG_LEVEL=info

# =============================================================================
# Authentication Configuration
# =============================================================================
DEFAULT_REALM_NAME=master
# Endpoint hosts of the default realm, comma-separated: the names server-side
# callers use, such as `auth-server` in PORTAL_AUTH_SERVER_URL. Added at boot
# when missing, never removed.
DEFAULT_REALM_ENDPOINT_HOSTS=auth-server
SYSTEM_CLIENT_ID=system

# Optional. The session cookie is signed with the realm's cookie key in the
# key store, which the first boot generates. Set this only to keep the secret
# a deployment already signs with: at boot, a value the store lacks replaces
# the stored cookie key. Min 32 chars; generate with: openssl rand -base64 48
SESSION_COOKIE_SECRET=

# Require a verified account before password login succeeds (default: true).
# For a password account, verified means its address was confirmed. An
# unverified account gets the same 401 as a wrong password.
# Seeds accounts.requireVerifiedAccount of a new realm; an existing realm keeps
# its own, so a later change here leaves it as it is.
# Keep it on: with it off, registering an address and then logging in with the
# chosen password tells a free address from a registered one.
# The mock email provider delivers no mail, so with EMAIL_PROVIDER=mock a new
# account cannot be verified and cannot sign in. Configure smtp or resend.
# REQUIRE_EMAIL_VERIFIED is the deprecated name. It still works during the 1.x
# deprecation window and logs a warning at boot. Setting both names to
# different values fails the boot.
# REQUIRE_VERIFIED_ACCOUNT=true

# Expose the Swagger UI at /docs (default: false in production).
# Set ENABLE_SWAGGER=true to opt back in for an internal docs mirror.
# ENABLE_SWAGGER=false

# Rate Limiting
REGISTRATION_RATE_LIMIT=3
REGISTRATION_RATE_WINDOW=3600
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=900

# =============================================================================
# Password Configuration
# =============================================================================
# Argon2id password hashing configuration
PASSWORD_MEMORY_COST=65536
PASSWORD_TIME_COST=3
PASSWORD_PARALLELISM=4
PASSWORD_HASH_QUEUE_LIMIT=32
# Seeds password.minScore of a new realm; an existing realm keeps its own.
PASSWORD_MIN_SCORE=2

# =============================================================================
# Email Configuration
# =============================================================================
# Email provider: 'mock', 'resend', or 'smtp'
# 'mock' logs emails to console (good for local development)
EMAIL_PROVIDER=mock

# Default sender information
EMAIL_FROM_ADDRESS=noreply@qauth.dev
EMAIL_FROM_NAME=QAuth

# Optional, and not read since 0.2.0: the links in mail (e.g., verification
# links) start at the issuer of the account's realm, JWT_ISSUER for the default
# realm. Another value than JWT_ISSUER only logs a warning at boot.
# EMAIL_BASE_URL=http://localhost:3000

# Email verification token expiry in seconds (default: 86400 = 24 hours)
EMAIL_VERIFICATION_TOKEN_EXPIRY=86400

# Whether to invalidate existing tokens when resending verification email
EMAIL_VERIFICATION_INVALIDATE_EXISTING_ON_RESEND=true

# Resend Provider Configuration (required if EMAIL_PROVIDER=resend)
# Get your API key from https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# SMTP Provider Configuration (required if EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=user@example.com
# SMTP_PASSWORD=your_smtp_password
# Operator-only: a relay without STARTTLS, and a non-public SMTP host (such as
# a relay container on the Compose network), are refused unless set here.
# SMTP_ALLOW_PLAINTEXT=false
# SMTP_ALLOWED_HOSTS=

# =============================================================================
# CORS Configuration
# =============================================================================
# CORS allowed origin. When unset, cross-origin requests are DENIED in
# production (fail-closed); set this to an explicit origin or a comma list to
# allow cross-origin callers. The wildcard '*' is permitted only in
# non-production for local dev convenience. Avoid '*' in production.
# CORS_ORIGIN=https://your-portal.example.com

# =============================================================================
# Rate Limiting (Global)
# =============================================================================
# Enable or disable rate limiting globally (default: true)
# Set to false to disable rate limiting (useful for development/testing)
RATE_LIMIT_ENABLED=true

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=3600

# Which reverse proxies may report the client address (X-Forwarded-For).
# Every per-IP rate limit and the failed-login lockout key on that address, so
# behind a proxy (nginx, Traefik, the developer portal) with this unset, every
# caller shares the proxy's address and one bucket. List only the addresses of
# the proxies in front of the auth-server and of the developer portal, never a
# range that clients can connect from: a broad private range such as
# `uniquelocal` or the whole Docker network also covers the bridge gateway,
# which host-local and published-port clients appear from. In this Compose
# stack the portal has a fixed address, 172.30.80.10 (<prefix>.10, see
# QAUTH_NETWORK_PREFIX below); add a reverse proxy's address after a comma.
# Each reverse proxy listed must append the address it accepted the connection
# from to X-Forwarded-For; the portal sets the header itself.
# Default: unset (no proxy trusted). `true` and hop counts are rejected: they
# would let any caller choose its own address.
# TRUST_PROXY=172.30.80.10

# Health endpoint rate limits (higher for Docker/K8s health checks)
HEALTH_RATE_LIMIT_MAX=1000
HEALTH_RATE_LIMIT_WINDOW=60

# =============================================================================
# Rate Limiting (Auth Endpoints)
# =============================================================================
# Email verification endpoint rate limits
VERIFICATION_RATE_LIMIT=10
VERIFICATION_RATE_WINDOW=900

# Resend verification endpoint rate limits
RESEND_VERIFICATION_RATE_LIMIT=100
RESEND_VERIFICATION_RATE_WINDOW=60
RESEND_VERIFICATION_EMAIL_LIMIT=3
RESEND_VERIFICATION_EMAIL_WINDOW=3600
RESEND_VERIFICATION_MIN_INTERVAL=60

# Refresh token endpoint rate limits
REFRESH_RATE_LIMIT=10
REFRESH_RATE_WINDOW=60

# Logout endpoint rate limits
LOGOUT_RATE_LIMIT=20
LOGOUT_RATE_WINDOW=60

# =============================================================================
# Developer Portal (apps/developer-portal)
# =============================================================================
# Required: 32+ char random secret used to sign the portal session cookie
# (__Host-qauth_portal_session). Generate with: openssl rand -hex 32
PORTAL_SESSION_SECRET=change-me-to-a-random-hex-string-at-least-32-chars
# Session cookie lifetime in seconds (default: 900 = 15 minutes)
PORTAL_SESSION_TTL=900
# Base URL the portal uses to reach the auth-server. Inside Docker Compose the
# default resolves over the service network; override only for split setups.
PORTAL_AUTH_SERVER_URL=http://auth-server:3000
# Browser-reachable auth-server URL for the portal's client-side fetches (e.g.
# the consents page). This is a VITE_ var baked into the image at BUILD time, so
# changing it requires rebuilding the portal. Default = host-published port.
PORTAL_PUBLIC_AUTH_SERVER_URL=http://localhost:3000
# Address of a reverse proxy in front of the portal (for example the one that
# terminates TLS), so the portal forwards each visitor's address to the
# auth-server rather than the proxy's. Comma-separated single IP addresses, not
# ranges; never an address clients can connect from. The proxy must append the
# address it accepted the connection from to X-Forwarded-For (for example,
# nginx: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for). On the
# Compose network, give the proxy a fixed address below <prefix>.128 (e.g.
# 172.30.80.20), and add it to TRUST_PROXY as well if it is also in front of
# the auth-server.
# Default: unset (no proxy trusted). `true` and hop counts are rejected.
# PORTAL_TRUST_PROXY=172.30.80.20
# First three octets of the Compose network's /24 (default: 172.30.80). The
# portal's fixed address is <prefix>.10, the value for TRUST_PROXY above.
# Change it only if 172.30.80.0/24 overlaps a network on your host, and update
# TRUST_PROXY to match.
# QAUTH_NETWORK_PREFIX=172.30.80
