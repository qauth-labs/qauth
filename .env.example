# Database Configuration
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Example: postgresql://qauth:password@localhost:5432/qauth_dev
DATABASE_URL=postgresql://qauth:password@localhost:5432/qauth_dev

# Database Pool Configuration (optional)
# Maximum number of clients in the pool
DB_POOL_MAX=20

# Minimum number of clients in the pool
DB_POOL_MIN=2

# Number of milliseconds a client is allowed to remain idle before being closed
DB_POOL_IDLE_TIMEOUT=10000

# Number of milliseconds to wait before timing out when connecting a new client
DB_POOL_CONNECTION_TIMEOUT=2000

# Redis Configuration
# Redis connection URL (primary method)
# Format: redis://username:password@host:port/database
# Example: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Alternative Redis configuration (if REDIS_URL is not provided)
# Redis host
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis password (optional)
# REDIS_PASSWORD=your_redis_password

# Redis database number (0-15)
REDIS_DB=0

# Redis Connection Pool Configuration
# Maximum number of connections in the pool
REDIS_MAX_CONNECTIONS=10

# Minimum number of connections in the pool
REDIS_MIN_CONNECTIONS=2

# Connection timeout in milliseconds
REDIS_CONNECTION_TIMEOUT=10000

# Command timeout in milliseconds
REDIS_COMMAND_TIMEOUT=5000

# Retry configuration
# Maximum number of retry attempts
REDIS_MAX_RETRIES=3

# Server Configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Log level: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# Observability Configuration
# Pretty-print logs via pino-pretty (development only; ignored in production).
# Production should emit JSON for log shippers. (default: false)
LOG_PRETTY=false
# HTTP header used to carry/propagate the request id (default: x-request-id).
# An inbound value is echoed back on the response and appears as `reqId` on logs.
REQUEST_ID_HEADER=x-request-id
# Expose the Prometheus GET /metrics endpoint (default: true).
METRICS_ENABLED=true

# Security posture (F-05/F-07/F-08/F-12)
# HMAC secret signing the __Host-qauth_session cookie. Min 32 chars. The
# dev default below is REJECTED in production by the env schema — set a
# strong secret in any non-dev deployment.
SESSION_COOKIE_SECRET=dev-only-session-secret-change-me-1234567890abcdef
# Require a verified email before password login succeeds (default: false).
# MVP posture allows unverified-email login; flip to true for a verified-email
# guarantee so the OIDC email_verified claim is trustworthy.
# REQUIRE_EMAIL_VERIFIED=false
# Expose the Swagger UI at /docs (default: true outside production, false in
# production). Set ENABLE_SWAGGER=true to opt back in for an internal docs mirror.
# ENABLE_SWAGGER=true

# CORS Configuration (optional)
# When unset in production, cross-origin requests are DENIED (fail-closed);
# in non-production the wildcard '*' is used for local dev convenience.
# CORS_ORIGIN=http://localhost:3000

# Failed-login throttling / lockout (QAuth 3.1.12)
# Track failed logins per identifier (email hash + IP) and temporarily lock out
# after too many failures in a window. (default: true)
FAILED_LOGIN_TRACKING_ENABLED=true
# Failures within the window before a lockout is applied (default: 5)
FAILED_LOGIN_MAX_ATTEMPTS=5
# Sliding window in seconds over which failures are counted (default: 900 = 15m)
FAILED_LOGIN_WINDOW=900
# Lockout duration in seconds once the threshold is reached (default: 900 = 15m)
FAILED_LOGIN_LOCKOUT_DURATION=900

# Rate Limiting Configuration
# Enable or disable rate limiting globally (default: true)
# Set to false to disable rate limiting (useful for development/testing)
RATE_LIMIT_ENABLED=true

# Global rate limit - maximum number of requests per time window
RATE_LIMIT_MAX=100

# Global rate limit - time window in seconds
RATE_LIMIT_WINDOW=3600

# Health endpoint rate limit - maximum number of requests per time window
# Health checks are typically more frequent, so higher limit (default: 1000)
HEALTH_RATE_LIMIT_MAX=1000

# Health endpoint rate limit window in seconds (default: 60 = 1 minute)
HEALTH_RATE_LIMIT_WINDOW=60

# Registration endpoint rate limit - maximum number of requests per time window
REGISTRATION_RATE_LIMIT=3

# Registration endpoint rate limit - time window in seconds
REGISTRATION_RATE_WINDOW=3600

# Email verification endpoint rate limit - maximum number of requests per time window
VERIFICATION_RATE_LIMIT=10

# Email verification endpoint rate limit - time window in seconds
VERIFICATION_RATE_WINDOW=900

# Resend verification endpoint rate limit - maximum number of requests per time window (per-IP)
RESEND_VERIFICATION_RATE_LIMIT=100

# Resend verification endpoint rate limit - time window in seconds
RESEND_VERIFICATION_RATE_WINDOW=60

# Per-email resend verification limit - maximum requests per email address per window
RESEND_VERIFICATION_EMAIL_LIMIT=3

# Per-email resend verification rate limit window in seconds (default: 3600 = 1 hour)
RESEND_VERIFICATION_EMAIL_WINDOW=3600

# Minimum interval between resend requests to same email in seconds
RESEND_VERIFICATION_MIN_INTERVAL=60

# Login endpoint rate limit - maximum number of requests per time window
LOGIN_RATE_LIMIT=5

# Login endpoint rate limit - time window in seconds (default: 900 = 15 minutes)
LOGIN_RATE_WINDOW=900

# Refresh token endpoint rate limit - maximum number of requests per time window
REFRESH_RATE_LIMIT=10

# Refresh token endpoint rate limit - time window in seconds (default: 60 = 1 minute)
REFRESH_RATE_WINDOW=60

# Logout endpoint rate limit - maximum number of requests per time window
LOGOUT_RATE_LIMIT=20

# Logout endpoint rate limit - time window in seconds (default: 60 = 1 minute)
LOGOUT_RATE_WINDOW=60

# Introspect endpoint rate limit - maximum number of requests per time window
INTROSPECT_RATE_LIMIT=30

# Introspect endpoint rate limit - time window in seconds (default: 60 = 1 minute)
INTROSPECT_RATE_WINDOW=60

# Authentication Configuration
# Default realm name for new user registrations
DEFAULT_REALM_NAME=master

# System OAuth client ID (optional, default: "system")
# Used for internal/system operations
# SYSTEM_CLIENT_ID=system

# JWT Configuration
# Supports both environment variables and file paths

# Option 1: Environment Variables
# EdDSA private key in PEM format (required if JWT_PRIVATE_KEY_PATH is not set)
# Used to sign JWT tokens
# Generate with: openssl genpkey -algorithm Ed25519 -out private.pem
# Example format:
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# MC4CAQAwBQYDK2VwBCIEI...
# -----END PRIVATE KEY-----"

# EdDSA public key in PEM format (optional if JWT_PUBLIC_KEY_PATH is not set)
# If not provided, can be derived from private key
# Extract with: openssl pkey -in private.pem -pubout -out public.pem
# Example format:
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# MCowBQYDK2VwAyEA...
# -----END PUBLIC KEY-----"

# Option 2: File Paths (Recommended for production, Kubernetes/Docker secrets)
# Path to EdDSA private key file in PEM format (required if JWT_PRIVATE_KEY is not set)
# Used to sign JWT tokens
# Generate with: openssl genpkey -algorithm Ed25519 -out private.pem
# For Kubernetes: Mount secret as volume and set path (e.g., /etc/secrets/jwt-private.pem)
# For Docker: Mount secret file and set path
# JWT_PRIVATE_KEY_PATH=/path/to/private.pem

# Path to EdDSA public key file in PEM format (optional if JWT_PUBLIC_KEY is not set)
# If not provided, can be derived from private key
# Extract with: openssl pkey -in private.pem -pubout -out public.pem
# JWT_PUBLIC_KEY_PATH=/path/to/public.pem

# Note: Provide either JWT_PRIVATE_KEY or JWT_PRIVATE_KEY_PATH (one is required)
# Note: Provide either JWT_PUBLIC_KEY or JWT_PUBLIC_KEY_PATH (both are optional)
# File paths take precedence if both are provided for the same key type

# RS256 ID token signing (#309, OPTIONAL — needed for OIDF OP certification #286)
#
# Absent (the default): ID tokens are signed EdDSA, exactly as before. Present:
# ID tokens switch to RS256 and the derived RSA public key is published in the
# JWKS alongside the Ed25519 key. Access tokens are ALWAYS EdDSA either way.
#
# The OpenID Foundation conformance suite hard-fails an EdDSA-only OP on the
# id_token signature test, so a certification deployment MUST set this. See
# docs/oidf-op-certification-runbook.md.
#
# MUST be PKCS#8 PEM ("-----BEGIN PRIVATE KEY-----"). A PKCS#1 key
# ("-----BEGIN RSA PRIVATE KEY-----") is REJECTED. Which command yields which
# depends on your OpenSSL: `openssl genrsa` defaults to PKCS#8 since 3.0 (use
# `-traditional` for PKCS#1), but emits PKCS#1 on 1.1.x and earlier. The
# `openssl genpkey` form below emits PKCS#8 on every version — prefer it. To
# convert an existing PKCS#1 key:
#   openssl pkcs8 -topk8 -nocrypt -in old.pem -out jwt-rs256-private.pem
#
# Generate with (RSA MUST be >= 2048-bit):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-rs256-private.pem
# JWT_RS256_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# MIIEvQIBADANBgkqhkiG9w0BAQEFAASC...
# -----END PRIVATE KEY-----"
# JWT_RS256_PRIVATE_KEY_PATH=/path/to/jwt-rs256-private.pem
#
# RS256 public key in SPKI PEM (optional — derived from the private key when
# omitted). Extract with:
#   openssl pkey -in jwt-rs256-private.pem -pubout -out jwt-rs256-public.pem
# JWT_RS256_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# MIIBIjANBgkqhkiG9w0BAQEFAAOC...
# -----END PUBLIC KEY-----"
# JWT_RS256_PUBLIC_KEY_PATH=/path/to/jwt-rs256-public.pem
#
# Stable `kid` for the published RSA JWK. Recommended: kid distinctness across
# published keys is enforced when the JWKS is served, so a collision surfaces as
# a 500 on /.well-known/jwks.json rather than at boot.
# JWT_RS256_KID=rsa-2026

# JWT issuer URL (required)
# Used as the 'iss' claim in JWT tokens
JWT_ISSUER=https://auth.qauth.dev

# Access token expiration in seconds (default: 900 = 15 minutes)
ACCESS_TOKEN_LIFESPAN=900

# Refresh token expiration in seconds (default: 604800 = 7 days)
REFRESH_TOKEN_LIFESPAN=604800

# Post-Quantum Cryptography (ADR-005, opt-in — all defaults keep QAuth on
# classical Ed25519). See docs/adr/005-pqc-hybrid-signing.md.
#
# Runtime algorithm selection. 'ed25519' (default) or 'ed25519+ml-dsa-65'.
# SIGNING_ALGORITHM_MODE=ed25519
#
# Enable hybrid (Ed25519 + ML-DSA-65) signing capability. Requires
# SIGNING_ALGORITHM_MODE=ed25519+ml-dsa-65 AND an ML-DSA key below, or startup
# fails fast. Default off.
# HYBRID_SIGNING_ENABLED=false
#
# ML-DSA-65 private key as a base64url 32-byte seed (or _PATH to a file). Only
# needed when HYBRID_SIGNING_ENABLED=true.
# JWT_MLDSA_PRIVATE_KEY=
# JWT_MLDSA_PRIVATE_KEY_PATH=/path/to/mldsa-seed
# JWT_MLDSA_KID=mldsa-2026
#
# How the ML-DSA component is delivered when hybrid is on (#247). 'reference'
# (default) keeps the bearer token a small Ed25519 JWS and delivers the ~4.4 KB
# PQC signature via RFC 7662 introspection. 'self-contained' carries it with the
# token and REQUIRES PQC_SELF_CONTAINED_ACK=true (it exceeds cookie/URL limits;
# large-buffer header-only deployments).
# PQC_TOKEN_DELIVERY=reference
# PQC_SELF_CONTAINED_ACK=false

# Wallet Federation (ADR-004, epic #231 — opt-in and INCOMPLETE).
# See docs/adr/004-wallet-agnostic-federation.md.
#
# Registers the 'wallet' CredentialProvider (OID4VP 1.0) in the provider
# registry. Leave this OFF until #233-#238 have landed: today the provider is a
# skeleton (#232) whose verify() and extractAttributes() throw by design, so it
# still authenticates nobody and no existing auth flow resolves 'wallet'. It
# exists so the flag wiring is testable ahead of the protocol work. Default off.
#
# NOT inert at startup any more, as of #299: turning this on now REQUIRES
# OID4VP_VERIFIER_PROFILE below. A deployment that sets the flag without a
# profile fails to boot — see the UPGRADE note under that variable.
#
# (SIOPv2 is NOT the mechanism — that framing was corrected in #295. HAIP 1.0 §5
# requires response type 'vp_token', which excludes the Self-Issued ID Token.)
# WALLET_FEDERATION_ENABLED=false

# Which VerifierProfile this deployment operates under (#299). Decides the
# protocol posture (which OID4VP capabilities are required/permitted/forbidden)
# AND which Client Identifier Prefix QAuth presents to prove it is the Verifier.
#
#   oid4vp-1.0-base  The protocol floor. Presents the certificate-free
#                    'redirect_uri' prefix, so it runs on today's crypto. For
#                    self-contained ecosystems, non-EU deployments and dev.
#   haip-1.0         EUDI-aligned. Requires ES256 (#298), encrypted responses,
#                    and an 'x509_hash' prefix backed by a QTSP-issued WRPAC.
#                    NOT USABLE YET, and refused on all three counts, not just
#                    the certificate: no ES256 signer, no JWE stack (#298), and
#                    no way to provision the WRPAC (#298/#233).
#
# DELIBERATELY HAS NO DEFAULT. Unset means no profile is selected; if
# WALLET_FEDERATION_ENABLED is also on, the server REFUSES TO START rather than
# serve wallet flows with an unstated posture. There is never a fallback to the
# more permissive profile (#296, LOCKED). Irrelevant while the flag is off.
#
# A blank value (OID4VP_VERIFIER_PROFILE=, which is what compose's ${VAR:-}
# expands to) is read as UNSET, not as an error — blanking a variable is how
# operators say "not configured", and a wallet-unrelated deployment must never
# lose its boot over this. A typo is still a hard failure.
#
# UPGRADE — READ THIS IF YOU ALREADY RUN WITH WALLET_FEDERATION_ENABLED=true.
# Before #299 that flag registered an inert skeleton and the server started
# regardless. It no longer does: the same environment now refuses to boot, which
# takes down password login, /authorize and /token — not just wallet flows.
# Do ONE of these BEFORE deploying this version:
#   1. Set OID4VP_VERIFIER_PROFILE=oid4vp-1.0-base. It is the only value that
#      boots today; haip-1.0 refuses to start until the QTSP-issued WRPAC, the
#      ES256 signer and the JWE stack all exist (#298/#233). It changes nothing
#      observable, because the provider still cannot authenticate anyone.
#   2. Or set WALLET_FEDERATION_ENABLED=false. This is the honest choice while
#      #233-#238 are open — you lose nothing, since nothing resolves 'wallet'.
# OID4VP_VERIFIER_PROFILE=oid4vp-1.0-base

# Which credential ISSUERS each realm trusts (#236). This is the OPPOSITE trust
# direction to OID4VP_VERIFIER_PROFILE above: that one is how QAuth proves it is
# the Verifier, this one is whose credentials QAuth is willing to accept once
# presentation validation has cryptographically established who issued them.
# The two never share configuration.
#
# JSON object: realm NAME (realms.name, not the uuid) -> array of issuer
# identifiers. Example:
#   OID4VP_TRUSTED_ISSUERS={"master":["https://issuer.example"],"acme":[]}
#
# PER REALM, NEVER GLOBAL, and there is deliberately no deployment-wide fallback
# list: an issuer added for one tenant must not become trusted by every other
# tenant. A realm absent from this map trusts NO issuer.
#
# FAIL-CLOSED. Unset, blank and {} all mean "no realm trusts any issuer", which
# is the refusing state, not a permissive one. A blank value (which is what
# compose's ${VAR:-} expands to) is read as unset and never fails the boot.
#
# A value that is PRESENT but malformed IS a hard boot failure, deliberately:
# "trusts nothing" is also the legitimate default, so a typo that degraded to it
# silently would be indistinguishable from a correct empty configuration. Each
# entry must be an absolute https:// URL with NO userinfo, query string or
# fragment (https://user:pw@issuer.example, https://issuer.example?x=1 and
# https://issuer.example#f are all rejected) — trust is matched on a
# canonicalized identifier, and an entry that cannot be canonicalized would make
# its whole realm reject every presentation. Caps: 256 realms, 64 issuers per
# realm, 2048 characters per issuer, 64 KiB total.
#
# Case, a default :443 and trailing slashes are normalized away, so
# https://Issuer.EXAMPLE:443/ and https://issuer.example are the same issuer.
# OID4VP_TRUSTED_ISSUERS={"master":["https://issuer.example"]}

# What each realm considers a trusted issuer's credentials to be WORTH (#237).
# A THIRD variable in this neighbourhood, and deliberately separate from
# OID4VP_TRUSTED_ISSUERS above: that one decides whether an issuer may be
# accepted at all, this one decides the eIDAS Level of Assurance a credential
# from it establishes. Listing an issuer here does NOT make it trusted — an
# issuer must appear in BOTH variables to produce an assured session.
#
# The level becomes the OIDC `acr` claim of the ID token QAuth issues
# downstream, so a Relying Party can require e.g. eIDAS "high" for a sensitive
# operation. See docs/adr/010-acr-assurance-mapping.md.
#
# JSON object: realm NAME -> issuer identifier -> { "level": ..., optional
# "credentialTypes": [...] }. Example:
#   OID4VP_ISSUER_ASSURANCE={"master":{"https://issuer.example":{"level":"high","credentialTypes":["urn:eudi:pid:1"]}}}
#
# level is "substantial" or "high". "low" is NOT configurable: it is what an
# unlisted issuer already resolves to, it emits no `acr` claim, and an entry
# granting it would be a no-op that reads like a control.
#
# credentialTypes is OPTIONAL and names the `vct` values the statement covers.
# Omitting it covers every credential type the issuer signs — appropriate only
# for an issuer that issues one kind of credential. An issuer that runs a strong
# identity-proofing process for its PID and something weaker for a loyalty
# credential must name the types, or the weak credential inherits the strong
# level. A type-scoped entry wins over an issuer-wide one for the same issuer.
#
# WHY THIS IS CONFIGURATION AT ALL: a Level of Assurance never arrives in the
# protocol. OID4VP 1.0 §5 fixes the response type to `vp_token`, so there is no
# wallet-signed assertion for a level to travel in, and HAIP 1.0 §1 states that
# the profile alone does not reach LoA "high". LoA is a property of the
# ecosystem — identity proofing, wallet certification, secure cryptographic
# device — and only the operator knows which ecosystems a deployment
# participates in. QAuth refuses to infer it.
#
# FAIL-CLOSED, per realm, no deployment-wide fallback. Unset, blank and {} all
# mean "no realm assures any issuer", so no ID token carries `acr`. A value that
# is PRESENT but malformed is a hard boot failure, for the same reason as the
# allowlist above. Caps: 256 realms, 64 issuers per realm, 32 credential types
# per issuer, 2048 characters per identifier, 64 KiB total.
# OID4VP_ISSUER_ASSURANCE={"master":{"https://issuer.example":{"level":"high"}}}

# Which vocabulary the `acr` claim is written in (#237). No registered `acr`
# value exists for an eIDAS Level of Assurance — the research behind this is
# recorded in docs/adr/010-acr-assurance-mapping.md — so the emitted string is a
# deployment choice between two documented conventions:
#
#   eidas-uri (default)  http://eidas.europa.eu/LoA/substantial | .../high
#                        The eIDAS SAML-era URIs. An absolute URI, which is what
#                        OIDC Core §2 asks an `acr` value to be. The http:
#                        scheme is part of the identifier as eIDAS defines it —
#                        nothing dereferences it, and rewriting it to https:
#                        produces a string no eIDAS-aware RP recognises.
#   loa-name             substantial | high
#                        The bare names used by several national eID -> OIDC
#                        bridges. Choose this only if your Relying Parties
#                        already consume them.
#
# There is no free-text option: an arbitrary value could collide with an
# RFC 6711 registered `acr` name while meaning something else, which OIDC Core
# §2 forbids. Under BOTH styles, an authentication that established no assurance
# above "low" — every password login — emits NO `acr` claim at all.
# ACR_VALUE_STYLE=eidas-uri
# The PUBLIC KEYS credential issuers sign with (#234/#238). Without this, nothing
# can verify a Verifiable Presentation and every wallet flow refuses.
#
# A THIRD, separate question from the two variables above, and the three must not
# be conflated:
#   OID4VP_VERIFIER_PROFILE  — who are WE, to a wallet?
#   OID4VP_TRUSTED_ISSUERS   — which issuers does a realm ACCEPT?
#   OID4VP_ISSUER_JWKS       — which key does an issuer SIGN WITH?
# Configuring a key here grants NO trust: a credential whose signature verifies
# under a key here is still refused unless its issuer is on the presenting
# realm's allowlist. And an allowlisted issuer with no key here can never present
# anything. Both directions fail closed, which is why they do not share a
# variable.
#
# JSON object: issuer identifier -> array of that issuer's PUBLIC JWKs. Keyed by
# issuer rather than by realm, because a key is a property of the issuer: two
# realms that both trust one issuer verify against the same key.
#   OID4VP_ISSUER_JWKS={"https://issuer.example":[{"kty":"EC","crv":"P-256","x":"...","y":"...","kid":"k1"}]}
#
# More than one key per issuer is normal (rotation). When an issuer has more than
# one, its credentials MUST carry a `kid` — the resolver refuses to guess, because
# guessing is how a rotated-out key stays live.
#
# PUBLIC keys only. A JWK carrying private material (d, p, q, dp, dq, qi, oth, k)
# FAILS THE BOOT: an issuer's private key in a verifier's configuration means a
# secret has been mis-copied into an environment variable.
#
# Unset, blank and {} all mean "no issuer key is configured" — every presentation
# refused, never "accept anything". A value that is PRESENT but malformed is a
# hard boot failure, for the same reason as OID4VP_TRUSTED_ISSUERS above. Caps:
# 256 issuers, 16 keys per issuer, 2048 characters per issuer identifier,
# 128 KiB total.
# OID4VP_ISSUER_JWKS={"https://issuer.example":[{"kty":"EC","crv":"P-256","x":"...","y":"...","kid":"k1"}]}

# CREDENTIAL REVOCATION — Token Status List (#297). Two variables, and a checker
# is built only when BOTH are set. Setting exactly one FAILS THE BOOT: a checker
# with no anchors refuses every Status List Token, and one with no permitted URI
# refuses every credential that carries a `status` claim — both silently, which
# is the failure mode this whole feature exists to avoid.
#
# A FOURTH trust question, sharing configuration with none of the three above:
#   OID4VP_VERIFIER_PROFILE       — who are WE, to a wallet?
#   OID4VP_TRUSTED_ISSUERS        — which issuers does a realm ACCEPT?
#   OID4VP_ISSUER_JWKS            — which key does an issuer SIGN WITH?
#   OID4VP_STATUS_LIST_* (here)   — which CA may vouch for a STATUS issuer, and
#                                   where may status lists be fetched from?
#
# WHAT HAPPENS WITH NEITHER SET: no revocation checking. A credential's `status`
# claim is not read and `assurance.statusChecked` reports "not-required", which
# is exactly the behaviour every release before #378 had. That is only tolerable
# under a profile that does not mandate status — OID4VP_VERIFIER_PROFILE=haip-1.0
# declares `requireCredentialStatus: true` and REFUSES TO START without both
# variables, naming which one is missing, rather than booting and then rejecting
# every login.
#
# FAIL-CLOSED, and there is no timeout escape hatch. A status endpoint that is
# down, 500s, serves the wrong media type or is behind an open circuit REFUSES
# the login. It is not "assume valid": an attacker who can degrade a third
# party's availability would otherwise be able to un-revoke credentials. The
# accepted cost is that a status endpoint outage blocks logins for that issuer's
# users; a per-origin circuit breaker (5 consecutive failures, 30 s open, one
# half-open probe) makes the outage cheap to absorb, never permissive.
#
# The request timeout (3 s) and the cache ceiling (300 s, the revocation
# FRESHNESS bound) are deliberately not configurable. Both are policy rather
# than tuning — the cache ceiling in particular exists so an issuer publishing
# `ttl: 86400` cannot choose QAuth's freshness for it.

# The X.509 anchors a Status List Token's `x5c` chain must terminate at
# (HAIP §6.1.1). One or more concatenated PEM CERTIFICATE blocks.
#
# WHY THIS IS NOT OPTIONAL DECORATION: the Status List Token is signed by the
# STATUS issuer, which need not be the credential issuer, and is fetched over a
# URI the CREDENTIAL supplied. Nothing about the presentation authenticates it.
# A verifier that fetches a document from an attacker-named URI and believes what
# it says has not added revocation checking — it has added a way for an attacker
# to assert that a revoked credential is valid.
#
# Anchors only (the CA), never the leaf: the signing certificate must chain to
# one of these and must not be self-signed. Unset means "no status issuer is
# anchored", which refuses every token. Malformed PEM is a hard boot failure.
# Cap: 32 certificates, 256 KiB.
# OID4VP_STATUS_LIST_TRUST_ANCHORS="-----BEGIN CERTIFICATE-----
# MIIB...
# -----END CERTIFICATE-----"

# The same anchors, read from a file. The form to prefer: a CA bundle is several
# kilobytes of multi-line base64, which is what a mounted secret or ConfigMap is
# for and what an environment variable is bad at.
#
# UNIONED with the inline variable above, not overriding it — unlike
# JWT_PRIVATE_KEY_PATH, which WINS over JWT_PRIVATE_KEY. A signing key has one
# correct value, so two sources must be a precedence; a trust anchor set is a
# SET, and an operator who mounts a bundle and adds one anchor inline means both.
#
# A path that is SET but unreadable fails the boot — an unmounted secret must not
# look like a deployment that configured nothing.
# OID4VP_STATUS_LIST_TRUST_ANCHORS_PATH=/etc/qauth/status-list-anchors.pem

# Where status lists may be fetched from — the SSRF boundary. Comma-separated
# https:// URI prefixes.
#
# This is not a convenience list. A status list URI is a string the CREDENTIAL
# chose that QAuth is asked to make an outbound request to, and a credential is
# trivially minted with status.status_list.uri = "https://169.254.169.254/...".
# There is no ordering that makes an unconstrained fetch safe, because verifying
# the signature requires having fetched the document first.
#
# An allowlist rather than a blocklist: the legitimate set is small and known (a
# deployment federates with a handful of issuers whose status endpoints its
# operator can name), while a blocklist of "internal" addresses is a losing game
# — DNS names resolving into RFC 1918, IPv6-mapped IPv4, redirects, rebinding.
#
# Matching is by ORIGIN plus a SEGMENT-anchored path prefix, never a substring:
# a "https://issuer.example/status" prefix does NOT permit
# "https://issuer.example/status-evil/...". A prefix with no path pins the whole
# origin, which is the common configuration. Entries must carry no query string,
# no fragment and no userinfo; IP literals, localhost and plain http:// are
# refused whatever this variable says. Redirects are refused at fetch time.
#
# Unset means status lists may be fetched from NOWHERE. Cap: 64 prefixes, 2048
# characters each, 64 KiB total.
# OID4VP_STATUS_LIST_URI_ALLOWLIST=https://issuer.example/statuslists,https://status.other.example

# Which Verifiable Credential Types the wallet SIGN-IN SCREEN asks for (#239).
# Comma-separated list of `vct` values, matched by the wallet against the
# credentials it holds.
#
# NO DEFAULT, and the wallet-login entry point is NOT OFFERED without it. A DCQL
# query carrying no type constraint asks a wallet for any credential it holds,
# which OID4VP 1.0 §15.6 warns Verifiers against and which leaves the issuer
# trust registry above nothing to decide on. A plausible-looking default would be
# worse than none: a deployment would silently request a credential its operator
# never chose to accept.
#
# Blank is read as unset, like the two variables above.
# OID4VP_REQUESTED_VCT=urn:eudi:pid:1

# How a validated presentation is resolved to an ACCOUNT (#300, ADR-009).
# See docs/adr/009-wallet-account-resolution.md.
#
# There is no protocol-guaranteed stable wallet subject identifier, and the
# ecosystem is deliberately built to keep it that way: EUDI PID technical
# validity is days to weeks, batched credentials are bound to different keys for
# unlinkability, the mandatory PID attribute set contains no identifier, and
# SD-JWT VC's `sub` is optional and refusable. So which account a presentation
# belongs to is a DEPLOYMENT decision, and this is where you state it.
#
#   asserted-lookup      DEFAULT. The user types the account (email/username) on
#                        the wallet sign-in screen and the presentation proves
#                        ENTITLEMENT to it. The only strategy viable in every
#                        ecosystem; survives re-issuance, key rotation, device
#                        change and a holder declining an attribute.
#   issuer-scoped-claim  Keyed on (validated issuer, claim). Opt-in for a NAMED
#                        issuer that contractually guarantees a stable, disclosed
#                        claim — a workforce credential with an employee number.
#                        Always falls back to asserted-lookup when the holder
#                        withholds the claim.
#   session-binding      NOT SELECTABLE HERE. It answers "link this credential to
#                        the account I am already signed in as", not "who am I";
#                        the account-linking flow selects it. Configuring it
#                        fails the boot with that explanation.
#   key-thumbprint       NOT IMPLEMENTED, actively discouraged. A thumbprint of
#                        the wallet's `cnf` key identifies a CREDENTIAL, not a
#                        person, and the key rotates by design.
#   rp-pseudonym         RESERVED. The EU's intended mechanism (a
#                        relying-party-specific pseudonym). Gated on a WebAuthn
#                        workstream, a published technical specification, and
#                        wallet support that is more than a MAY. None cleared.
#
# Unset means "use the active VerifierProfile's default", which is
# asserted-lookup for both shipped profiles. Blank is read as unset. A typo is a
# hard boot failure.
# OID4VP_SUBJECT_RESOLUTION=asserted-lookup

# Which credential claims prove ENTITLEMENT to the asserted account (#300).
# Comma-separated claim names.
#
# THIS IS THE SECURITY-CRITICAL ONE. A validated, issuer-trusted presentation
# proves only that the holder has *a* valid credential. Without a binding to
# match against the asserted account, ANY valid credential would authenticate
# ANY account — a total authentication bypass, and ADR-009 §1 names it as the
# likeliest way this feature gets built wrong.
#
# QAuth records a digest of (validated issuer, credential type, these claims)
# when a wallet credential is enrolled, and re-derives and compares it on every
# later presentation. Choose claims that identify a PERSON in your ecosystem: an
# EUDI PID deployment binds on the mandatory attribute set, a workforce
# deployment on an employee number. The strength of the check is the strength of
# this list.
#
# NO DEFAULT — a plausible-looking default would be a weak binding nobody
# reviewed. A deployment using (or inheriting) asserted-lookup with this unset is
# refused. `iss` and `cnf` may never be named: keying on a self-asserted issuer
# is a takeover, and keying on holder key material is what ADR-009 §4 forbids.
# OID4VP_SUBJECT_BINDING_CLAIMS=family_name,given_name,birth_date

# The claim carrying the issuer's stable subject identifier, for
# OID4VP_SUBJECT_RESOLUTION=issuer-scoped-claim only (#300, ADR-009 §2).
# Ignored by every other strategy; required by that one.
# OID4VP_SUBJECT_CLAIM=personal_administrative_number

# Which issuers issuer-scoped-claim is OPTED IN for (#300, ADR-009 §2).
# Comma-separated https:// issuer identifiers.
#
# ADR-009 permits that strategy only where a specific, NAMED issuer
# contractually guarantees a stable, disclosed claim — a guarantee QAuth cannot
# verify in code. A presentation from any other issuer, trusted or not, takes the
# asserted-lookup fallback instead.
#
# Distinct from OID4VP_TRUSTED_ISSUERS and never a substitute for it: that list
# decides whether a credential counts at all, this one decides whether one of
# those credentials may KEY an account. An issuer here that is not also trusted
# there is inert.
# OID4VP_SUBJECT_CLAIM_ISSUERS=https://pid.member-state.example

# Where the wallet sign-in screen's QR code and "Open my wallet" button point
# (#239). OID4VP 1.0 §5 delivers the request as query parameters of the WALLET's
# own Authorization Endpoint — either the registered custom scheme (the default
# below, which reaches whichever wallet the user has installed) or a universal
# link belonging to one specific wallet.
#
# Mostly only the SHAPE is validated (an absolute URI with a scheme and no
# fragment) — which endpoint is correct is an ecosystem question this server
# cannot answer. Any wallet scheme works: openid4vp://, haip://, a vendor's
# eudi-wallet:// or its https:// universal link.
#
# The one refusal: this value is rendered into an href, so a script-capable
# scheme (javascript:, data:, vbscript:, and their case/entity-encoded
# spellings) FAILS THE BOOT rather than shipping an XSS payload to every user
# who opens the wallet sign-in screen.
# OID4VP_WALLET_INVOCATION_ENDPOINT=openid4vp://

# Password Configuration
# Minimum password strength score (0-4, where 0=very weak, 4=strong)
# Default: 2 (Fair)
PASSWORD_MIN_SCORE=2

# Argon2id password hashing configuration
# Memory cost in KB (default: 65536 = 64MB)
PASSWORD_MEMORY_COST=65536

# Time cost / iterations (default: 3)
PASSWORD_TIME_COST=3

# Parallelism / threads (default: 4)
PASSWORD_PARALLELISM=4

# Email Configuration
# Email verification token expiry in seconds (default: 86400 = 24 hours)
EMAIL_VERIFICATION_TOKEN_EXPIRY=86400

# Whether to invalidate existing tokens when resending verification email
# If true, only the latest token is valid (more secure)
# If false, multiple tokens can be active (user can use any valid token)
EMAIL_VERIFICATION_INVALIDATE_EXISTING_ON_RESEND=true

# Email provider type: 'mock', 'resend', or 'smtp'
# Default: 'mock' (logs to console, no actual emails sent)
EMAIL_PROVIDER=mock

# Default sender email address (required)
EMAIL_FROM_ADDRESS=noreply@example.com

# Default sender name (default: 'QAuth')
EMAIL_FROM_NAME=QAuth

# Base URL for email links (e.g., verification links) (required)
EMAIL_BASE_URL=https://example.com

# Resend Provider Configuration (required if EMAIL_PROVIDER=resend)
# Get your API key from https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# SMTP Provider Configuration (required if EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=user@example.com
# SMTP_PASSWORD=your_smtp_password

# Test Configuration (optional, for test environments)
# TEST_DATABASE_URL=postgresql://qauth:password@localhost:5432/qauth_test
# TEST_REDIS_URL=redis://localhost:6379/1

# Developer Portal Configuration (apps/developer-portal)
# Base URL of the auth-server this portal will call for authentication.
# Must be reachable from the Node.js server process (not the browser).
AUTH_SERVER_URL=http://localhost:3001

# Secret used to sign the portal session cookie (__Host-qauth_portal_session).
# Must be at least 32 characters of random data. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_SESSION_SECRET=change-me-to-a-random-hex-string-at-least-32-chars

# Lifetime of the portal session cookie in seconds (default: 900 = 15 minutes)
PORTAL_SESSION_TTL=900
