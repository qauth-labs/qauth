{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // The options of the former .prettierrc, as `oxfmt --migrate prettier`
  // carried them over. Oxfmt formats JS and TS itself and every other type
  // Prettier formatted (JSON, YAML, Markdown, MDX, CSS) through the Prettier
  // printers it bundles, so the same files are formatted as before.
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  // Prettier never sorted package.json keys; Oxfmt does unless told not to.
  "sortPackageJson": false,
  // What prettier-plugin-tailwindcss did, with the same algorithm: sort the
  // Tailwind classes in `class` and `className` attributes and in the
  // arguments of these functions, against the installed Tailwind theme.
  "sortTailwindcss": {
    "functions": ["clsx", "cva"]
  },
  // Gitignore-style, like the former .prettierignore; .gitignore applies too.
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".nx",
    "coverage",
    "*.log",
    "pnpm-lock.yaml",
    "**/routeTree.gen.ts",
    // Generated by `nx run auth-server:openapi-export` (#347, #451) — plain
    // JSON.stringify output, not formatted; don't let it drift.
    "apps/docs-site/public/openapi.json",
    "stable-surface/openapi.json",
    // Generated by `nx run shared-events:schema-export` (#456) — plain
    // JSON.stringify output, like openapi.json; don't let it drift.
    "apps/docs-site/public/schemas/events/",
    // Generated by `nx run auth-server:admin-permissions-export` (#507) — plain
    // JSON.stringify output, like the event schemas; don't let it drift.
    "apps/docs-site/public/schemas/admin-permissions.json",
    // Generated by `nx run shared-test-vectors:schema-export` (#478) — plain
    // JSON.stringify output, like the event schemas; don't let it drift.
    "test-vectors/schema/",
    // Generated by `nx run shared-interaction-contract:contract-export` (#590) —
    // plain JSON.stringify output, like the event schemas; don't let it drift.
    "apps/docs-site/public/interaction/",
    // The official OpenAPI 3.1 schemas, vendored byte for byte (#590): the
    // library's README (libs/shared/interaction-contract/README.md) records
    // their source and digests.
    "libs/shared/interaction-contract/src/lib/oas/",
    // Prettier had no TOML printer, so these files were never formatted.
    // Oxfmt has one; left out so the switch formats the same set of files.
    "*.toml"
  ]
}
