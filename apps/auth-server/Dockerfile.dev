# Auth Server – Development Dockerfile
# Uses nx serve --watch; pair with docker-compose.dev.yml + Compose Watch (sync).

FROM node:26-alpine

WORKDIR /app

# A dev container has no cache token and nothing to cache: serve/dev tasks are
# never cached.
ENV NX_NO_CLOUD=true

# pnpm comes from npm at the exact version CI uses. Node 26 no longer ships
# corepack, and a pinned global install means nothing fetches pnpm later.
ARG PNPM_VERSION=12.14.0
RUN npm install --global pnpm@${PNPM_VERSION}

# Dependencies only (layer cache)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY nx.json tsconfig.base.json ./
COPY vitest.config.ts ./
RUN pnpm install --frozen-lockfile

# Workspace (Compose Watch will sync over these; writable for sync targets)
COPY libs ./libs
COPY apps ./apps

RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001 && \
    chown -R nodejs:nodejs /app

USER nodejs

EXPOSE 3000

# Nx serve --watch: build on change, restart node
CMD ["pnpm", "nx", "serve", "auth-server", "--watch"]
