{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.qauth.dev/interaction/v1-rc.0/steps/admin_enrolment.json",
  "title": "urn:qauth:ia:admin_enrolment:v1-rc.0",
  "description": "The one-time enrolment of an admin account that the break-glass CLI created with no password and no credential (ADR-019 Decision 7). The CLI prints a URL on the realm origin, `/ui/admin-enrolment#token=…`, whose token travels in the fragment, which no server, proxy log or `Referer` sees. The ceremony app serves that page: it reads the token from the fragment, takes it out of the address bar, and, when the person asks (a button, never on load, so a link scanner that runs scripts starts nothing), posts it as a plain HTML form with the one member `token` to the auth server's `POST /auth/admin-enrolment`, from the realm origin. That starts an interaction at this step in that browser, with its own flow cookie, and sends the browser to the ceremony page. A token that is unknown, used, expired or damaged gets one answer, the same for each, and no interaction. Starting does not spend the token: it is spent once, in the transaction that stores the passkey, and the interaction ends no later than the token expires. `options` and the personal data are those of `webauthn_create`: a discoverable passkey, user verification required, the RP ID the realm’s host. The step cannot be declined and is offered with no alternative: the account never gets a password. A refused registration comes back with `invalid_credentials` and new options. Once the passkey is stored the interaction finishes with a redirect to a page that says so; the account signs in with its passkey from then on, and cannot approve another admin’s request for 7 days. A cancel leaves the token unspent until it expires. Enrolment adds no `amr` value and signs nobody in. Needs JavaScript.",
  "x-qauth-transports": [
    "interaction"
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "urn:qauth:ia:admin_enrolment:v1-rc.0",
      "description": "The step name."
    },
    "params": {
      "$ref": "#/$defs/params"
    },
    "answer": {
      "$ref": "#/$defs/answer"
    },
    "personal": {
      "$ref": "#/$defs/personal"
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "amr": {
      "$ref": "#/$defs/amr"
    }
  },
  "required": [
    "type",
    "params",
    "answer",
    "personal",
    "amr"
  ],
  "examples": [
    {
      "type": "urn:qauth:ia:admin_enrolment:v1-rc.0",
      "params": {
        "options": {
          "challenge": "Qm9vbGVhbi1ub3QtYS1yZWFsLWNoYWxsZW5nZS0zMmI",
          "rp": {
            "id": "auth.example.com",
            "name": "Example"
          },
          "pubKeyCredParams": [
            {
              "type": "public-key",
              "alg": -8
            },
            {
              "type": "public-key",
              "alg": -7
            },
            {
              "type": "public-key",
              "alg": -257
            }
          ],
          "timeout": 300000,
          "authenticatorSelection": {
            "residentKey": "required",
            "userVerification": "required"
          },
          "attestation": "none"
        }
      },
      "answer": {
        "webauthn_response": "{\"id\":\"Xb3hH0p2SdK1nJw7eVq4yA\",\"rawId\":\"Xb3hH0p2SdK1nJw7eVq4yA\",\"type\":\"public-key\",\"response\":{\"clientDataJSON\":\"eyJ0eXBlIjoid2ViYXV0aG4uY3JlYXRlIn0\",\"attestationObject\":\"o2NmbXRkbm9uZWdhdHRTdG10oGhhdXRoRGF0YVjE\",\"transports\":[\"internal\",\"hybrid\"]},\"authenticatorAttachment\":\"platform\",\"clientExtensionResults\":{}}"
      },
      "personal": {
        "user": {
          "id": "YWRtaW4tdXNlci1oYW5kbGU",
          "name": "admin-YWRtaW4t",
          "displayName": "admin-YWRtaW4t"
        }
      },
      "amr": []
    }
  ],
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "options": {
          "type": "object",
          "properties": {
            "challenge": {
              "type": "string",
              "minLength": 43,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]{43,128}$",
              "description": "The challenge, at least 32 random bytes."
            },
            "rp": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
                  "description": "The relying party ID: the realm’s host."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^<>\\p{C}\\p{Z}\\u115F\\u1160\\u3164\\uFFA0](?:[^<>\\p{C}\\p{Zl}\\p{Zp}\\u115F\\u1160\\u3164\\uFFA0]*[^<>\\p{C}\\p{Z}\\u115F\\u1160\\u3164\\uFFA0])?$",
                  "x-qauth-display": "realm",
                  "description": "The realm’s display name."
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            },
            "pubKeyCredParams": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "description": "The COSE algorithms the server accepts, preferred first.",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "public-key"
                  },
                  "alg": {
                    "type": "integer",
                    "enum": [
                      -8,
                      -7,
                      -257
                    ],
                    "description": "EdDSA, ES256 or RS256."
                  }
                },
                "required": [
                  "type",
                  "alg"
                ],
                "additionalProperties": false
              }
            },
            "timeout": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 600000,
              "description": "How long the ceremony may take, in milliseconds."
            },
            "authenticatorSelection": {
              "type": "object",
              "properties": {
                "residentKey": {
                  "const": "required",
                  "description": "A passkey is discoverable."
                },
                "userVerification": {
                  "const": "required"
                }
              },
              "required": [
                "residentKey",
                "userVerification"
              ],
              "additionalProperties": false
            },
            "attestation": {
              "const": "none",
              "description": "QAuth asks for no attestation and claims nothing about the key store."
            }
          },
          "required": [
            "challenge",
            "rp",
            "pubKeyCredParams",
            "authenticatorSelection",
            "attestation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "options"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "options": {
            "challenge": "Qm9vbGVhbi1ub3QtYS1yZWFsLWNoYWxsZW5nZS0zMmI",
            "rp": {
              "id": "auth.example.com",
              "name": "Example"
            },
            "pubKeyCredParams": [
              {
                "type": "public-key",
                "alg": -8
              },
              {
                "type": "public-key",
                "alg": -7
              },
              {
                "type": "public-key",
                "alg": -257
              }
            ],
            "timeout": 300000,
            "authenticatorSelection": {
              "residentKey": "required",
              "userVerification": "required"
            },
            "attestation": "none"
          }
        }
      ]
    },
    "answer": {
      "type": "object",
      "properties": {
        "webauthn_response": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16384,
          "contentMediaType": "application/json",
          "contentSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "rawId": {
                "type": "string"
              },
              "type": {
                "const": "public-key"
              },
              "response": {
                "type": "object",
                "properties": {
                  "clientDataJSON": {
                    "type": "string"
                  },
                  "attestationObject": {
                    "type": "string"
                  },
                  "transports": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "clientDataJSON",
                  "attestationObject"
                ]
              },
              "authenticatorAttachment": {
                "type": "string"
              },
              "clientExtensionResults": {
                "type": "object"
              }
            },
            "required": [
              "id",
              "rawId",
              "type",
              "response",
              "clientExtensionResults"
            ]
          },
          "description": "The registration response, `PublicKeyCredential.toJSON()` (WebAuthn Level 3), as a JSON string. It is a string on both transports, so a form post carries it in one field (ADR-017 Decision 3)."
        }
      },
      "required": [
        "webauthn_response"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "webauthn_response": "{\"id\":\"Xb3hH0p2SdK1nJw7eVq4yA\",\"rawId\":\"Xb3hH0p2SdK1nJw7eVq4yA\",\"type\":\"public-key\",\"response\":{\"clientDataJSON\":\"eyJ0eXBlIjoid2ViYXV0aG4uY3JlYXRlIn0\",\"attestationObject\":\"o2NmbXRkbm9uZWdhdHRTdG10oGhhdXRoRGF0YVjE\",\"transports\":[\"internal\",\"hybrid\"]},\"authenticatorAttachment\":\"platform\",\"clientExtensionResults\":{}}"
        }
      ]
    },
    "personal": {
      "type": "object",
      "properties": {
        "user": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 86,
              "pattern": "^[A-Za-z0-9_-]{1,86}$",
              "description": "The user handle: an opaque id, at most 64 bytes."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^<>\\p{C}\\p{Z}\\u115F\\u1160\\u3164\\uFFA0](?:[^<>\\p{C}\\p{Zl}\\p{Zp}\\u115F\\u1160\\u3164\\uFFA0]*[^<>\\p{C}\\p{Z}\\u115F\\u1160\\u3164\\uFFA0])?$",
              "x-qauth-display": "account",
              "description": "The account name the authenticator shows."
            },
            "displayName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^<>\\p{C}\\p{Z}\\u115F\\u1160\\u3164\\uFFA0](?:[^<>\\p{C}\\p{Zl}\\p{Zp}\\u115F\\u1160\\u3164\\uFFA0]*[^<>\\p{C}\\p{Z}\\u115F\\u1160\\u3164\\uFFA0])?$",
              "x-qauth-display": "account",
              "description": "The display name the authenticator shows."
            }
          },
          "required": [
            "id",
            "name",
            "displayName"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "user"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "user": {
            "id": "YWRtaW4tdXNlci1oYW5kbGU",
            "name": "admin-YWRtaW4t",
            "displayName": "admin-YWRtaW4t"
          }
        }
      ]
    },
    "error": {
      "type": "string",
      "enum": [
        "invalid_credentials"
      ],
      "description": "Why the last answer was refused. A closed set."
    },
    "amr": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "const": [],
      "description": "The RFC 8176 `amr` values a successful answer adds to the transaction: none, because the step proves no authenticator."
    }
  }
}
