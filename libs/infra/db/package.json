{
  "name": "@qauth-labs/infra-db",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./migrations": "./src/migrations.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "migrations": [
        "src/migrations.ts"
      ]
    }
  },
  "dependencies": {
    "@node-rs/argon2": "catalog:",
    "@qauth-labs/shared-errors": "workspace:*",
    "@qauth-labs/shared-events": "workspace:*",
    "@qauth-labs/shared-validation": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "drizzle-seed": "catalog:",
    "pg": "catalog:",
    "tslib": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@qauth-labs/shared-testing": "workspace:*",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:"
  }
}
