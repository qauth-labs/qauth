// QAuth Database Schema
// Three-table identity model: users (anchor), user_credentials (auth methods), user_attributes (claims)
// Designed for wallet-agnostic federation — email/password in Phase 1, SIOPv2/OID4VP wallets in Phase 4
// Generated from Drizzle ORM schema for visualization on dbdiagram.io

// ============================================================================
// ENUMS
// ============================================================================

Enum "token_endpoint_auth_method" {
  "client_secret_post" [note: "Client credentials in POST body (default)"]
  "client_secret_basic" [note: "Client credentials in HTTP Basic Auth header"]
  "private_key_jwt" [note: "JWT signed with private key"]
  "none" [note: "Public client (no authentication)"]
}

Enum "ssl_required" {
  "none" [note: "SSL never required"]
  "external" [note: "SSL required for external requests only"]
  "all" [note: "SSL required for all requests"]
}

Enum "code_challenge_method" {
  "S256" [note: "SHA256 (only supported method - plain text is insecure and not supported)"]
}

Enum "grant_type" {
  "authorization_code" [note: "Authorization Code Flow (with PKCE)"]
  "refresh_token" [note: "Refresh Token Flow"]
  "client_credentials" [note: "Client Credentials Flow (for service-to-service)"]
}

Enum "response_type" {
  "code" [note: "Authorization Code (only supported in OAuth 2.1)"]
}

Enum "realm_host_kind" {
  "primary" [note: "The realm's issuer host: one per realm, permanent, never an IP literal"]
  "endpoint" [note: "An extra name for server-to-server callers; API routes only"]
}

Enum "audit_event_type" {
  "auth" [note: "Authentication events (login, logout, register)"]
  "token" [note: "Token events (issued, refreshed, revoked)"]
  "client" [note: "Client events (created, updated, deleted)"]
  "security" [note: "Security events (failed login, suspicious activity)"]
  "user" [note: "User management events"]
  "realm" [note: "Realm management events"]
}

Enum "admin_actor_kind" {
  "human_admin" [note: "An admin account, signed in with a passkey"]
  "service_account" [note: "An operator-realm service account (client_credentials)"]
  "break_glass_operator" [note: "The break-glass CLI; actor_id is the operating-system user"]
  "host_operator" [note: "A host-side tool such as the seed script; actor_id is the operating-system user"]
}

Enum "admin_operation_class" {
  "read"
  "write"
  "security"
}

Enum "admin_audit_outcome" {
  "succeeded"
  "failed"
  "denied"
}

// ============================================================================
// CORE TABLES
// ============================================================================

Table "realms" {
  "id" uuid [pk, default: `uuidv7()`]
  "name" varchar(255) [not null, unique]
  "enabled" boolean [not null, default: true]
  "issuer" text [unique, note: "RFC 8414 issuer: https (plain http only on localhost), no trailing slash, white space, control characters or backslash; permanent once set (trigger); NULL until the boot step fills it"]
  "is_operator" boolean [not null, default: false, note: "The operator realm; at most one"]
  "webauthn_rp_id" varchar(253) [note: "Passkey RP ID: NULL means the primary host, a value is an opted-in parent domain; a domain name in realm host form; unchangeable once webauthn_rp_id_locked_at is set (trigger)"]
  "webauthn_rp_id_locked_at" bigint [note: "When the first passkey enrolment locked the RP ID, epoch ms; NULL while the realm has no passkey; permanent once set (trigger)"]
  "access_token_lifespan" bigint [default: 900, note: "15 minutes in seconds"]
  "refresh_token_lifespan" bigint [default: 604800, note: "7 days in seconds"]
  "ssl_required" "ssl_required" [default: 'external']
  "verify_email" boolean [not null, default: true]
  "registration_allowed" boolean [not null, default: false]
  "login_with_email_allowed" boolean [not null, default: true]
  "duplicate_emails_allowed" boolean [not null, default: false]
  "password_policy" jsonb [note: "Password policy configuration: { minLength, requireUppercase, requireDigits, etc. }"]
  "sso_idle_timeout" bigint [note: "in seconds"]
  "sso_max_lifespan" bigint [note: "in seconds"]
  "revoke_refresh_token" boolean [not null, default: false]
  "refresh_token_max_reuse" integer [default: 0, note: "0 = unlimited"]
  "default_locale" varchar(10)
  "supported_locales" jsonb [default: `'[]'::jsonb`]
  "user_event_retention_days" integer [not null, default: 90, note: "1 to 36500 (#536); seeded by EVENT_RETENTION_USER_DAYS"]
  "admin_event_retention_days" integer [not null, default: 365, note: "90 to 36500 (#536); seeded by EVENT_RETENTION_ADMIN_DAYS"]
  "metadata" jsonb [note: "Additional realm configuration"]
  "created_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]
  "updated_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]

  Indexes {
    enabled [name: "idx_realms_enabled", note: "Partial index: WHERE enabled = true"]
    is_operator [unique, name: "idx_realms_one_operator", note: "Partial unique index: WHERE is_operator = true"]
  }
}

// One host exists once across every realm and both kinds (host is the primary key).
// Hosts are stored lower-case, ASCII (punycode), with no port and no trailing dot.
Table "realm_hosts" {
  "host" varchar(253) [pk, note: "Normalised by normaliseRealmHost()"]
  "realm_id" uuid [not null, ref: > realms.id]
  "kind" realm_host_kind [not null]
  "created_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]

  Indexes {
    realm_id [unique, name: "idx_realm_hosts_one_primary", note: "Partial unique index: WHERE kind = 'primary'"]
    realm_id [name: "idx_realm_hosts_realm_id"]
  }
}

// Identity anchor only. No email, no password_hash, no credential-specific columns.
// One row per user across all authentication methods (password, wallet, OIDC federation).
// OIDC sub claim is always this table's id (UUID) — never email, never external_sub.
Table "users" {
  "id" uuid [pk, default: `uuidv7()`]
  "realm_id" uuid [not null, ref: > realms.id]
  "enabled" boolean [not null, default: true]
  "first_name" varchar(255) [note: "Sourced into the OIDC name claim"]
  "last_name" varchar(255)
  "metadata" jsonb [note: "Flexible storage for additional user data"]
  "created_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]
  "updated_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]
  "last_login_at" bigint

  Indexes {
    (id, realm_id) [unique, name: "users_id_realm_id_unique", note: "Unique constraint; target of sessions_user_realm_fk"]
    realm_id [name: "idx_users_realm_id"]
    enabled [name: "idx_users_enabled", note: "Partial index: WHERE enabled = true"]
  }
}

// One row per authentication method per user.
// provider_type discriminates the method. external_sub is the method-specific subject identifier.
// credential_data is a JSONB blob carrying method-specific fields (password hash, wallet metadata, etc.)
// Unique constraint on (realm_id, provider_type, external_sub) enforces per-method uniqueness.
Table "user_credentials" {
  "id" uuid [pk, default: `uuidv7()`]
  "user_id" uuid [not null, ref: > users.id]
  "realm_id" uuid [not null, ref: > realms.id]
  "provider_type" text [not null, note: "'password' | 'wallet' | 'oidc_*' | 'did' — plain text (not enum) so the open-ended oidc_* family needs no schema migration"]
  "external_sub" text [not null, note: "'password': normalized email | 'wallet': DID or issuer subject | 'oidc_*': upstream sub claim"]
  "credential_data" jsonb [not null, default: `'{}'::jsonb`, note: "'password': { password_hash, email_verified } | 'wallet': wallet/VC metadata | 'oidc_*': upstream claims. CHECK jsonb_typeof = 'object'"]
  "created_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]
  "updated_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]

  Indexes {
    (realm_id, provider_type, external_sub) [unique, name: "idx_user_credentials_realm_provider_sub_unique"]
    user_id [name: "idx_user_credentials_user_id"]
    realm_id [name: "idx_user_credentials_realm_id"]
  }
}

// Claims and attributes as data, not identity anchors.
// source tracks where the attribute came from and determines trust level.
// Trust order for claim resolution: wallet > oidc_* > self_reported
// email claim is present in OIDC tokens only if a verified row exists here.
// If no verified email exists, the email claim is omitted entirely (not null).
Table "user_attributes" {
  "id" uuid [pk, default: `uuidv7()`]
  "user_id" uuid [not null, ref: > users.id]
  "source" text [not null, note: "'self_reported' | 'wallet' | 'oidc_google' — plain text (not enum). Trust order wallet > oidc_* > self_reported is enforced in app code (#229), not the DB"]
  "attr_key" text [not null, note: "Attribute name, e.g. 'email', 'name', 'birthdate', 'phone_number'"]
  "attr_value" text [not null]
  "verified" boolean [not null, default: false]
  "expires_at" bigint [note: "For VC-derived attributes — null for self-reported attributes"]
  "created_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]
  "updated_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]

  Indexes {
    (user_id, source, attr_key) [unique, name: "idx_user_attributes_user_source_key_unique"]
    user_id [name: "idx_user_attributes_user_id"]
  }
}

// References user_credentials (not users) because email verification is a property
// of the password authentication method, not of the abstract user identity.
Table "email_verification_tokens" {
  "id" uuid [pk, default: `uuidv7()`]
  "token_hash" varchar(64) [not null, unique, note: "SHA-256 hash of the verification token"]
  "credential_id" uuid [not null, ref: > user_credentials.id]
  "expires_at" bigint [not null]
  "used" boolean [not null, default: false]
  "used_at" bigint
  "created_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]

  Indexes {
    credential_id [name: "idx_email_verification_tokens_credential_id"]
    (token_hash, expires_at) [name: "idx_email_verification_tokens_active", note: "Partial index: WHERE used = false"]
    expires_at [name: "idx_email_verification_tokens_expires_at"]
  }
}

Table "oauth_clients" {
  "id" uuid [pk, default: `uuidv7()`]
  "realm_id" uuid [not null, ref: > realms.id]
  "client_id" varchar(255) [not null]
  "client_secret_hash" text [not null, note: "Argon2id hash"]
  "name" varchar(255) [not null]
  "description" text
  "redirect_uris" jsonb [not null, note: "Array of allowed redirect URIs"]
  "scopes" jsonb [not null, default: `'[]'::jsonb`, note: "Default OAuth scopes"]
  "client_credentials_scopes" jsonb [note: "The scopes the client_credentials grant may issue, out of scopes; NULL = any of them; set only through the seed manifest (#891)"]
  "enabled" boolean [not null, default: true]
  "require_pkce" boolean [not null, default: true, note: "PKCE required by default (OAuth 2.1)"]
  "token_endpoint_auth_method" "token_endpoint_auth_method" [not null, default: 'client_secret_post']
  "grant_types" jsonb [not null, default: `'["authorization_code","refresh_token"]'::jsonb`, note: "Array of grant_type enum values"]
  "response_types" jsonb [not null, default: `'["code"]'::jsonb`, note: "Array of response_type enum values"]
  "developer_id" uuid [ref: > users.id, note: "Nullable for system clients"]
  "webauthn_allowed_origins" jsonb [not null, default: `'[]'::jsonb`, note: "Operator-set passkey origins of a native app, such as android:apk-key-hash:...; set only through the seed manifest"]
  "dpop_bound_access_tokens" boolean [not null, default: false, note: "RFC 9449 §5.2: refuse token requests without a DPoP proof while DPOP_ENABLED is on; set only through the seed manifest (#480)"]
  "metadata" jsonb [note: "Additional client configuration"]
  "created_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]
  "updated_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]
  "last_used_at" bigint

  Indexes {
    (realm_id, client_id) [unique, name: "idx_oauth_clients_realm_client_id_unique"]
    client_id [name: "idx_oauth_clients_client_id"]
    realm_id [name: "idx_oauth_clients_realm_id"]
    developer_id [name: "idx_oauth_clients_developer_id"]
    enabled [name: "idx_oauth_clients_enabled", note: "Partial index: WHERE enabled = true"]
    (realm_id, client_id, enabled) [name: "idx_oauth_clients_realm_client_id_enabled"]
  }
}

Table "authorization_codes" {
  "id" uuid [pk, default: `uuidv7()`]
  "code" varchar(255) [not null, unique]
  "oauth_client_id" uuid [not null, ref: > oauth_clients.id]
  "user_id" uuid [not null, ref: > users.id]
  "redirect_uri" text [not null]
  "code_challenge" text [not null, note: "PKCE code challenge"]
  "code_challenge_method" "code_challenge_method" [not null, default: 'S256']
  "nonce" text [note: "OIDC nonce parameter — opaque, client-owned, no spec length limit (#316)"]
  "auth_time" bigint [note: "OIDC Core §2 auth_time (epoch ms) — when the end-user actually authenticated"]
  "assurance_level" text [note: "eIDAS LoA of that authentication: 'substantial' | 'high' | NULL (no acr claim) — #237"]
  "scopes" jsonb [not null, default: `'[]'::jsonb`]
  "state" text [note: "CSRF protection state parameter — opaque, client-owned, no spec length limit (#316)"]
  "dpop_jkt" varchar(43) [note: "RFC 9449 §10: thumbprint of the DPoP key the code is bound to; redeemed only with a proof under it (#480)"]
  "expires_at" bigint [not null, note: "TTL: 5 minutes"]
  "used" boolean [not null, default: false, note: "Single-use codes"]
  "used_at" bigint
  "created_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]

  Indexes {
    (code, expires_at) [name: "idx_authorization_codes_active", note: "Partial index: WHERE used = false"]
    expires_at [name: "idx_authorization_codes_expires_at"]
    user_id [name: "idx_authorization_codes_user_id"]
    oauth_client_id [name: "idx_authorization_codes_oauth_client_id"]
  }
}

Table "refresh_tokens" {
  "id" uuid [pk, default: `uuidv7()`]
  "token_hash" text [not null, unique]
  "user_id" uuid [not null, ref: > users.id]
  "oauth_client_id" uuid [not null, ref: > oauth_clients.id]
  "scopes" jsonb [not null, default: `'[]'::jsonb`]
  "expires_at" bigint [not null, note: "TTL: 7 days"]
  "revoked" boolean [not null, default: false]
  "revoked_at" bigint
  "revoked_reason" varchar(255) [note: "e.g., 'user_logout', 'security_breach'"]
  "previous_token_hash" text [note: "Hash of previous token if rotated"]
  "cnf_jkt" varchar(43) [note: "RFC 9449 §5: thumbprint of the DPoP key a public client's refresh token is bound to; kept across rotations (#480)"]
  "created_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]
  "last_used_at" bigint

  Indexes {
    (token_hash, expires_at) [name: "idx_refresh_tokens_active", note: "Partial index: WHERE revoked = false"]
    expires_at [name: "idx_refresh_tokens_expires_at"]
    user_id [name: "idx_refresh_tokens_user_id"]
    oauth_client_id [name: "idx_refresh_tokens_oauth_client_id"]
    (user_id, expires_at) [name: "idx_refresh_tokens_user_active", note: "Partial index: WHERE revoked = false"]
  }
}

Table "audit_logs" {
  "id" uuid [pk, default: `uuidv7()`]
  "user_id" uuid [ref: > users.id, note: "Nullable for system events"]
  "oauth_client_id" uuid [ref: > oauth_clients.id, note: "Nullable for system events"]
  "event" varchar(100) [not null, note: "e.g., 'user.login', 'user.register', 'token.issued'"]
  "event_type" "audit_event_type" [not null]
  "success" boolean [not null, default: true]
  "ip_address" varchar(45) [note: "IPv6 compatible"]
  "user_agent" text
  "metadata" jsonb [note: "Additional event data"]
  "created_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]

  Indexes {
    user_id [name: "idx_audit_logs_user_id"]
    oauth_client_id [name: "idx_audit_logs_oauth_client_id"]
    event_type [name: "idx_audit_logs_event_type"]
    event [name: "idx_audit_logs_event"]
    created_at [name: "idx_audit_logs_created_at"]
    (user_id, event, created_at) [name: "idx_audit_logs_user_event"]
    (event, created_at) [name: "idx_audit_logs_failed", note: "Partial index: WHERE success = false"]
    ip_address [name: "idx_audit_logs_ip_address"]
  }
}

// Admin audit log (ADR-019 Decision 7, #448). Append-only: triggers refuse
// UPDATE and TRUNCATE, accept a row only as the next link of its chain, and a
// DELETE only of rows a checkpoint covers; admin_audit_log_prune() writes the
// checkpoint, oldest rows first and never younger than 90 days. One hash chain per target realm:
// row_hash = SHA-256(prev_hash || RFC 8785 canonical JSON of the other columns).
// No foreign keys, so a realm's record outlives the realm row.
Table "admin_audit_log" {
  "realm_id" uuid [not null, note: "Target realm: the chain the row belongs to"]
  "seq" bigint [not null, note: "From 1, without a gap"]
  "prev_hash" bytea [not null, note: "32 bytes; 32 zero bytes on seq 1"]
  "row_hash" bytea [not null, note: "32 bytes"]
  "actor_kind" "admin_actor_kind" [not null]
  "actor_id" varchar(255) [not null]
  "actor_realm_id" uuid [note: "Null exactly for the host-side actor kinds"]
  "act_chain" jsonb [note: "{ sub, act } when the actor acted for a user"]
  "operation_id" varchar(128) [not null, note: "Permission catalog id"]
  "operation_class" "admin_operation_class" [not null]
  "effects" jsonb [not null]
  "outcome" "admin_audit_outcome" [not null]
  "masked_diff" jsonb [note: "{ before, after } with every secret field masked"]
  "approvals" jsonb [not null]
  "request_digest" bytea [note: "32 bytes"]
  "trace_id" varchar(128)
  "created_at" bigint [not null]

  Indexes {
    (realm_id, seq) [pk, name: "admin_audit_log_pk"]
  }
}

// Where a realm's chain resumes after a prune: seq and row_hash of the last
// removed row. Written by admin_audit_log_prune(), accepted only over an
// unbroken run of rows at least 90 days old; append-only.
Table "admin_audit_log_checkpoints" {
  "realm_id" uuid [not null]
  "seq" bigint [not null]
  "row_hash" bytea [not null]
  "created_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]

  Indexes {
    (realm_id, seq) [pk, name: "admin_audit_log_checkpoints_pk"]
  }
}

// Event store (ADR-019 Decision 8, #457): the transactional outbox and the
// event log in one append-only table. An event is written in the transaction
// of the change it records. Readers take a realm's rows in (xid, seq) order,
// and only rows whose xid is below their snapshot's xmin, so a row committed
// late by an older transaction is never skipped. No foreign keys: an event
// outlives the realm, user or client it names.
Table "events" {
  "seq" bigint [pk, increment, note: "GENERATED ALWAYS AS IDENTITY"]
  "xid" xid8 [not null, default: `pg_current_xact_id()`, note: "The writing transaction"]
  "id" uuid [not null, unique, note: "Envelope id, a UUIDv7"]
  "realm_id" uuid [not null]
  "category" varchar(16) [not null, note: "user | admin"]
  "type" varchar(255) [not null, note: "urn:qauth:event:<name>:v<N>[-rc.<M>]"]
  "time" bigint [not null, note: "Epoch ms"]
  "actor_type" varchar(32)
  "actor_id" varchar(255)
  "actor_delegation_chain" jsonb [note: "client_id values, the acting agent first"]
  "subject_type" varchar(32)
  "subject_id" varchar(255)
  "client_id" varchar(255)
  "request_id" varchar(128) [note: "request.traceId"]
  "request_ip" varchar(45)
  "request_user_agent" varchar(1024)
  "data" jsonb [not null]
  "schema_version" smallint [not null, note: "Row layout version; 1"]

  Indexes {
    (realm_id, xid, seq) [name: "idx_events_realm_position"]
    (realm_id, type) [name: "idx_events_realm_type"]
    subject_id [name: "idx_events_subject_id"]
    (realm_id, category, time) [name: "idx_events_retention", note: "Retention reads a realm's oldest rows of one category"]
  }
}

// Where each realm's admin chain starts once the retention job (#536) has
// deleted its oldest admin rows: the seq and hash of the last one it deleted,
// written in the same transaction. verifyChain starts from it. No foreign key,
// as for events.
Table "event_chain_anchors" {
  "realm_id" uuid [pk]
  "seq" bigint [not null, note: "The last admin row deleted; only ever moves forward"]
  "hash" bytea [not null, note: "That row's hash: the prev_hash of the oldest admin row left"]
  "updated_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]
}

// ============================================================================
// EVENT DELIVERY (ADR-019 Decision 8, #460)
// ============================================================================

// One row per destination and event: the unit of at-least-once delivery. A
// worker claims a row with FOR UPDATE SKIP LOCKED and leases it until
// locked_until; the claim counts the attempt and moves next_attempt_at to the
// lease's end. Times are the worker's clock (epoch ms). A row is deleted with
// its event.
Table "event_deliveries" {
  "id" uuid [pk, default: `uuidv7()`]
  "destination_kind" varchar(32) [not null, note: "The route's kind: webhook, ssf, ..."]
  "destination_id" varchar(255) [not null, note: "The destination within its route"]
  "event_id" uuid [not null, ref: > events.id, note: "ON DELETE CASCADE"]
  "realm_id" uuid [not null]
  "event_xid" xid8 [not null, note: "The event's position, with event_seq"]
  "event_seq" bigint [not null]
  "event_time" bigint [not null, note: "The event's time (epoch ms), for the lag gauge"]
  "status" varchar(16) [not null, default: 'pending', note: "pending | delivered | failed"]
  "attempt_count" integer [not null, default: 0, note: "Counted at each claim"]
  "next_attempt_at" bigint [not null, note: "A retry's time, or a lease's end"]
  "locked_until" bigint [note: "The lease's end; NULL while no worker holds the row"]
  "last_status_code" smallint [note: "100 to 599"]
  "last_error_class" varchar(64) [note: "A short class such as timeout, never a message"]
  "created_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]
  "updated_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]
  "finished_at" bigint [note: "Set exactly when status is not pending"]

  Indexes {
    (event_id, destination_kind, destination_id) [unique, name: "event_deliveries_event_destination_unique"]
    (destination_kind, destination_id, next_attempt_at) [name: "idx_event_deliveries_due", note: "Partial index: WHERE status = 'pending'"]
    (realm_id, event_xid, event_seq) [name: "idx_event_deliveries_pending_position", note: "Partial index: WHERE status = 'pending'"]
    event_time [name: "idx_event_deliveries_pending_time", note: "Partial index: WHERE status = 'pending'"]
  }
}

// How far the fan-out has read each realm's stream, per route kind. A realm
// has a row for a kind only while it has a destination of that kind.
Table "event_delivery_positions" {
  "realm_id" uuid [not null]
  "destination_kind" varchar(32) [not null, note: "The route kind whose destinations this position feeds"]
  "xid" xid8 [not null, note: "The last event read, or a horizon"]
  "seq" bigint [not null, note: "0 before the first event of xid"]
  "updated_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]

  Indexes {
    (realm_id, destination_kind) [pk, name: "event_delivery_positions_pk"]
  }
}

// ============================================================================
// BROWSER SESSIONS (ADR-019 Decision 3, #468)
// ============================================================================

// One row per account signed in on one browser, in one realm. The id is the
// session's sid. (user_id, realm_id) references users (id, realm_id), so a
// session never names a user of another realm. The cookie, the CSRF values and
// the consent scopes are not stored here.
Table "sessions" {
  "id" uuid [pk, default: `uuidv7()`, note: "The session's sid"]
  "realm_id" uuid [not null, ref: > realms.id]
  "user_id" uuid [not null, note: "(user_id, realm_id) references users (id, realm_id): sessions_user_realm_fk, ON DELETE CASCADE"]
  "auth_time" bigint [not null, note: "When the user authenticated (epoch ms); read by max_age and the auth_time claim"]
  "amr" jsonb [not null, default: `'[]'::jsonb`, note: "Authentication methods (RFC 8176); CHECK: JSON array"]
  "assurance_level" text [note: "'substantial' | 'high' | NULL"]
  "ip_address" varchar(45) [note: "At creation"]
  "user_agent" text [note: "At creation"]
  "expires_at" bigint [not null, note: "Absolute end (epoch ms)"]
  "revoked_at" bigint
  "revoked_reason" text [note: "sign_out | sign_out_everywhere | admin | reset | key_retired | browser_limit | idle | expired; set together with revoked_at"]
  "created_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]
  "last_seen_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`, note: "Throttled writes"]

  Indexes {
    user_id [name: "idx_sessions_user_id"]
    (realm_id, user_id) [name: "idx_sessions_realm_user_active", note: "Partial index: WHERE revoked_at IS NULL"]
    expires_at [name: "idx_sessions_expires_at"]
  }
}

// The clients a session has served, for back-channel logout.
Table "session_clients" {
  "session_id" uuid [not null, ref: > sessions.id, note: "ON DELETE CASCADE"]
  "oauth_client_id" uuid [not null, ref: > oauth_clients.id, note: "ON DELETE CASCADE"]
  "first_seen_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]

  Indexes {
    (session_id, oauth_client_id) [pk, name: "session_clients_pk"]
    oauth_client_id [name: "idx_session_clients_oauth_client_id"]
  }
}

// ============================================================================
// FUTURE: ROLES & PERMISSIONS (Phase 5+)
// ============================================================================

Table "roles" {
  "id" uuid [pk, default: `uuidv7()`]
  "realm_id" uuid [not null, ref: > realms.id]
  "name" varchar(255) [not null]
  "description" text
  "oauth_client_id" uuid [ref: > oauth_clients.id, note: "Client-specific roles (if set, role is scoped to that client)"]
  "enabled" boolean [not null, default: true]
  "metadata" jsonb
  "created_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]
  "updated_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]

  Indexes {
    (realm_id, name, oauth_client_id) [unique, name: "idx_roles_realm_name_unique"]
    name [name: "idx_roles_name"]
    realm_id [name: "idx_roles_realm_id"]
    oauth_client_id [name: "idx_roles_oauth_client_id"]
  }
}

Table "user_roles" {
  "user_id" uuid [not null, ref: > users.id]
  "role_id" uuid [not null, ref: > roles.id]
  "assigned_at" bigint [not null, default: `EXTRACT(EPOCH FROM NOW())::bigint * 1000`]
  "assigned_by" uuid [ref: > users.id]

  Indexes {
    (user_id, role_id) [pk, name: "user_roles_pk"]
    user_id [name: "idx_user_roles_user_id"]
    role_id [name: "idx_user_roles_role_id"]
  }
}

// ============================================================================
// RELATIONSHIPS
// ============================================================================

// IDENTITY MODEL:
// users is a pure identity anchor — no email, no password, no credential fields.
// user_credentials: one row per auth method per user
//   - provider_type='password' → external_sub is email, credential_data has password_hash
//   - provider_type='wallet'   → external_sub is DID or issuer subject (Phase 4)
//   - provider_type='oidc_*'  → external_sub is upstream sub claim (Phase 6+)
// user_attributes: claims as data with source tracking and trust ordering
//   - wallet > oidc_* > self_reported (trust order for claim resolution)
//   - email claim in OIDC tokens comes from here, not from users or user_credentials
//   - absent (not null) when no verified email attribute exists

// REALMS (Multi-tenancy):
// - Each realm is an isolated tenant
// - Realms can have multiple users, clients, roles, etc.
// - All data is scoped to a realm for isolation
// - user_credentials.realm_id enables the unique constraint on (realm_id, provider_type, external_sub)

// Users can have:
// - Belongs to one realm
// - Multiple user_credentials (one per authentication method)
// - Multiple user_attributes (email, name, etc. from various sources)
// - Multiple authorization codes
// - Multiple refresh tokens
// - Multiple sessions
// - Multiple audit logs
// - Multiple OAuth clients (as developer)
// - Multiple roles (via user_roles)

// OAuth clients can have:
// - Belongs to one realm
// - Multiple authorization codes (via oauth_client_id)
// - Multiple refresh tokens (via oauth_client_id)
// - Multiple sessions served (via session_clients)
// - Multiple roles (client-specific, via oauth_client_id)
// - Multiple audit logs (via oauth_client_id)
