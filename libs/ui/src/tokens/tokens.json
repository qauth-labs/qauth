{
  "$description": "QAuth design tokens (Design Tokens Community Group format 2025.10). Edit this file, then run `pnpm nx test ui -u` to regenerate src/styles/theme.css and src/styles/tailwind-theme.css.",
  "color": {
    "$type": "color",
    "$description": "Semantic colours. $value is the light mode; $extensions.mode holds both modes, the form Terrazzo reads. The contrast floors sit under $extensions[\"dev.qauth.ui\"].",
    "surface": {
      "background": {
        "$value": {
          "colorSpace": "oklch",
          "components": [1, 0, 0]
        },
        "$description": "The page.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [1, 0, 0]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.113, 0.004, 260]
            }
          }
        }
      },
      "card": {
        "$value": {
          "colorSpace": "oklch",
          "components": [1, 0, 0]
        },
        "$description": "A card or panel on the page.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [1, 0, 0]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.138, 0.005, 260]
            }
          }
        }
      },
      "popover": {
        "$value": {
          "colorSpace": "oklch",
          "components": [1, 0, 0]
        },
        "$description": "A menu, popover or dialog.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [1, 0, 0]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.138, 0.005, 260]
            }
          }
        }
      },
      "muted": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.97, 0.001, 106.424]
        },
        "$description": "A quiet fill: a code block, a table header, a disabled field.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.97, 0.001, 106.424]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.2, 0.005, 260]
            }
          }
        }
      },
      "secondary": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.967, 0.001, 286.375]
        },
        "$description": "The secondary button.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.967, 0.001, 286.375]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.274, 0.006, 286.033]
            }
          }
        }
      },
      "accent": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.97, 0.001, 106.424]
        },
        "$description": "The hover and selected fill of a menu item or ghost button. Not the brand accent: that is color.brand.highlight.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.97, 0.001, 106.424]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.2, 0.005, 260]
            }
          }
        }
      },
      "destructive-surface": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.97, 0.015, 27.325]
        },
        "$description": "The fill behind an error message or destructive action.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.97, 0.015, 27.325]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.22, 0.05, 22.216]
            }
          }
        }
      },
      "success-surface": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.97, 0.02, 149.214]
        },
        "$description": "The fill behind a success message.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.97, 0.02, 149.214]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.22, 0.05, 149.214]
            }
          }
        }
      }
    },
    "text": {
      "foreground": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.147, 0.004, 49.25]
        },
        "$description": "Headings and primary text.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.147, 0.004, 49.25]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.97, 0.002, 90]
            }
          },
          "dev.qauth.ui": {
            "contrast": [
              {
                "min": 4.5,
                "on": [
                  "{color.surface.background}",
                  "{color.surface.card}",
                  "{color.surface.popover}",
                  "{color.surface.muted}"
                ]
              }
            ]
          }
        }
      },
      "card-foreground": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.147, 0.004, 49.25]
        },
        "$description": "Text on a card.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.147, 0.004, 49.25]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.97, 0.002, 90]
            }
          },
          "dev.qauth.ui": {
            "contrast": [
              {
                "min": 4.5,
                "on": ["{color.surface.card}"]
              }
            ]
          }
        }
      },
      "popover-foreground": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.147, 0.004, 49.25]
        },
        "$description": "Text in a menu, popover or dialog.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.147, 0.004, 49.25]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.97, 0.002, 90]
            }
          },
          "dev.qauth.ui": {
            "contrast": [
              {
                "min": 4.5,
                "on": ["{color.surface.popover}"]
              }
            ]
          }
        }
      },
      "secondary-foreground": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.21, 0.006, 285.885]
        },
        "$description": "Text on the secondary button.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.21, 0.006, 285.885]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.985, 0, 0]
            }
          },
          "dev.qauth.ui": {
            "contrast": [
              {
                "min": 4.5,
                "on": ["{color.surface.secondary}", "{color.surface.accent}"]
              }
            ]
          }
        }
      },
      "accent-foreground": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.216, 0.006, 56.043]
        },
        "$description": "Text on the hover and selected fill.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.216, 0.006, 56.043]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.97, 0.002, 90]
            }
          },
          "dev.qauth.ui": {
            "contrast": [
              {
                "min": 4.5,
                "on": ["{color.surface.accent}"]
              }
            ]
          }
        }
      },
      "body": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.42, 0.013, 58]
        },
        "$description": "Running text: softer than foreground, stronger than muted.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.42, 0.013, 58]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.75, 0.008, 90]
            }
          },
          "dev.qauth.ui": {
            "contrast": [
              {
                "min": 4.5,
                "on": [
                  "{color.surface.background}",
                  "{color.surface.card}",
                  "{color.surface.muted}"
                ]
              }
            ]
          }
        }
      },
      "muted-foreground": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.53, 0.013, 58.071]
        },
        "$description": "Secondary text: hints, captions, placeholders. Light 0.53 (the design system's 0.553 was 4.4:1 on muted).",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.53, 0.013, 58.071]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.62, 0.008, 90]
            }
          },
          "dev.qauth.ui": {
            "contrast": [
              {
                "min": 4.5,
                "on": [
                  "{color.surface.background}",
                  "{color.surface.card}",
                  "{color.surface.popover}",
                  "{color.surface.muted}"
                ]
              }
            ]
          }
        }
      },
      "primary-text": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.5, 0.15, 38]
        },
        "$description": "The brand colour as text: links and text buttons. The fill itself is too dark for text in dark mode.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.5, 0.15, 38]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.72, 0.12, 45]
            }
          },
          "dev.qauth.ui": {
            "contrast": [
              {
                "min": 4.5,
                "on": [
                  "{color.surface.background}",
                  "{color.surface.card}",
                  "{color.surface.muted}"
                ]
              }
            ]
          }
        }
      }
    },
    "primary": {
      "primary": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.54, 0.15, 38]
        },
        "$description": "The brand colour as a fill: the primary button.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.54, 0.15, 38]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.54, 0.15, 38]
            }
          }
        }
      },
      "primary-hover": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.49, 0.14, 38]
        },
        "$description": "The primary button under the pointer. Darker, so its text keeps its contrast.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.49, 0.14, 38]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.49, 0.14, 38]
            }
          }
        }
      },
      "primary-foreground": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.98, 0.016, 73.684]
        },
        "$description": "Text on the primary fill.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.98, 0.016, 73.684]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.98, 0.016, 73.684]
            }
          },
          "dev.qauth.ui": {
            "contrast": [
              {
                "min": 4.5,
                "on": ["{color.primary.primary}", "{color.primary.primary-hover}"]
              }
            ]
          }
        }
      }
    },
    "brand": {
      "highlight": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.5, 0.1324, 194.77]
        },
        "$description": "The brand accent: emphasis, badges, the selected state. Light 0.5 (the design system's 0.7766 was 1.9:1 on white).",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.5, 0.1324, 194.77]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.75, 0.15, 195]
            }
          },
          "dev.qauth.ui": {
            "contrast": [
              {
                "min": 4.5,
                "on": [
                  "{color.surface.background}",
                  "{color.surface.card}",
                  "{color.surface.muted}"
                ]
              }
            ]
          }
        }
      }
    },
    "feedback": {
      "destructive": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.55, 0.22, 27.325]
        },
        "$description": "Errors and destructive actions. Light 0.55 (0.577 was 4.4:1 on muted).",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.55, 0.22, 27.325]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.704, 0.191, 22.216]
            }
          },
          "dev.qauth.ui": {
            "contrast": [
              {
                "min": 4.5,
                "on": [
                  "{color.surface.background}",
                  "{color.surface.card}",
                  "{color.surface.muted}",
                  "{color.surface.destructive-surface}"
                ]
              }
            ]
          }
        }
      },
      "success": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.52, 0.17, 149.214]
        },
        "$description": "Success messages.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.52, 0.17, 149.214]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.648, 0.223, 149.214]
            }
          },
          "dev.qauth.ui": {
            "contrast": [
              {
                "min": 4.5,
                "on": [
                  "{color.surface.background}",
                  "{color.surface.card}",
                  "{color.surface.success-surface}"
                ]
              }
            ]
          }
        }
      }
    },
    "line": {
      "border": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.923, 0.003, 48.717]
        },
        "$description": "Dividers and card edges. Decorative, so no contrast floor.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.923, 0.003, 48.717]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [1, 0, 0],
              "alpha": 0.08
            }
          }
        }
      },
      "input": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.62, 0.003, 48.717]
        },
        "$description": "The edge of a text field, checkbox or select: 3:1, as WCAG 1.4.11 asks of a control's boundary (the design system's was 1.2:1).",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.62, 0.003, 48.717]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.5, 0.008, 90]
            }
          },
          "dev.qauth.ui": {
            "contrast": [
              {
                "min": 3,
                "on": ["{color.surface.background}", "{color.surface.card}"]
              }
            ]
          }
        }
      },
      "ring": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.5, 0.1324, 194.77]
        },
        "$description": "The focus outline: the teal accent, so focus stands out from the primary orange and the greys. 3:1 or more against what it sits on (WCAG 1.4.11): 4.9:1 on white, 10:1 on the dark page.",
        "$extensions": {
          "mode": {
            "light": {
              "colorSpace": "oklch",
              "components": [0.5, 0.1324, 194.77]
            },
            "dark": {
              "colorSpace": "oklch",
              "components": [0.75, 0.15, 195]
            }
          },
          "dev.qauth.ui": {
            "contrast": [
              {
                "min": 3,
                "on": [
                  "{color.surface.background}",
                  "{color.surface.card}",
                  "{color.surface.muted}"
                ]
              }
            ]
          }
        }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "DM Sans Variable",
          "Hiragino Sans",
          "Hiragino Kaku Gothic ProN",
          "Noto Sans JP",
          "Yu Gothic",
          "Meiryo",
          "sans-serif"
        ],
        "$description": "Interface and running text."
      },
      "display": {
        "$value": [
          "Instrument Serif",
          "Hiragino Mincho ProN",
          "Yu Mincho",
          "Noto Serif JP",
          "serif"
        ],
        "$description": "Page and section headings (h1 to h3). One weight, 400."
      },
      "mono": {
        "$value": ["JetBrains Mono Variable", "monospace"],
        "$description": "Code, identifiers, secrets and one-time codes."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": {
          "value": 0.75,
          "unit": "rem"
        }
      },
      "sm": {
        "$value": {
          "value": 0.875,
          "unit": "rem"
        }
      },
      "base": {
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "lg": {
        "$value": {
          "value": 1.125,
          "unit": "rem"
        }
      },
      "xl": {
        "$value": {
          "value": 1.25,
          "unit": "rem"
        }
      },
      "2xl": {
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      },
      "3xl": {
        "$value": {
          "value": 1.875,
          "unit": "rem"
        }
      },
      "4xl": {
        "$value": {
          "value": 2.25,
          "unit": "rem"
        }
      },
      "5xl": {
        "$value": {
          "value": 3,
          "unit": "rem"
        }
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.2
      },
      "snug": {
        "$value": 1.375
      },
      "normal": {
        "$value": 1.5
      },
      "relaxed": {
        "$value": 1.65
      }
    }
  },
  "space": {
    "$type": "dimension",
    "unit": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      },
      "$description": "The spacing step. Every padding, gap and margin is a multiple of it."
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "The design system's corners are square.",
    "control": {
      "$value": {
        "value": 0,
        "unit": "px"
      },
      "$description": "Buttons, fields, badges."
    },
    "surface": {
      "$value": {
        "value": 0,
        "unit": "px"
      },
      "$description": "Cards, dialogs, menus."
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      },
      "$description": "Pills and avatars."
    }
  },
  "focus": {
    "$type": "dimension",
    "ring-width": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "ring-offset": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "$description": "Both drop to 0ms under prefers-reduced-motion.",
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        },
        "$description": "Hover and focus changes."
      },
      "normal": {
        "$value": {
          "value": 200,
          "unit": "ms"
        },
        "$description": "Opening a menu or dialog."
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [0.2, 0, 0, 1]
      }
    }
  }
}
