{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": [
    // `lint`: Oxlint (.oxlintrc.json), one batched process for every project
    // in the run.
    {
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "lint"
      }
    },
    // `dependency-checks`: the one rule still on ESLint, @nx/dependency-checks
    // on package.json files (eslint.config.mjs), because Oxlint does not lint
    // JSON. `extensions` makes a project's JSON files what earns it the target;
    // eslint.config.mjs ignores every JSON file but package.json, so a project
    // without one (test-vectors) gets none.
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "dependency-checks",
        "extensions": ["json"]
      }
    },
    // Both @nx/js/typescript entries run TypeScript 7's `tsgo`
    // (@typescript/native-preview) in place of `tsc`: `tsgo -p <config>
    // --noEmit` for `typecheck`, and `tsgo --build tsconfig.lib.json` for the
    // two builds this entry infers (ui and resource-guard), whose JavaScript is
    // byte-identical to tsc's. Two typecheck targets are declared in
    // project.json instead: auth-server's runs tsgo too, docs-site's runs
    // `astro check`.
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "compiler": "tsgo",
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      },
      "exclude": [
        "libs/infra/db/*",
        "libs/infra/cache/*",
        "libs/fastify/plugins/db/*",
        "libs/fastify/plugins/cache/*",
        "libs/fastify/plugins/password/*",
        "libs/fastify/plugins/email/*",
        "libs/fastify/plugins/jwt/*",
        "libs/shared/errors/*",
        "libs/server/config/*",
        "libs/server/email/*",
        "libs/server/password/*",
        "libs/shared/validation/*",
        "libs/shared/events/*",
        "libs/shared/stability/*",
        "libs/shared/testing/*",
        "libs/shared/test-vectors/*",
        "libs/shared/interaction-contract/*",
        "libs/shared/interaction-client/*",
        "libs/server/jwt/*",
        "libs/server/pkce/*",
        "libs/server/federation/*",
        "libs/server/keys/*",
        "libs/server/egress/*",
        "libs/server/event-delivery/*",
        "libs/server/ssf/*",
        "libs/server/sessions/*",
        "libs/server/dpop/*",
        "libs/server/realm-policy/*",
        "libs/server/step-grammar/*",
        "libs/fastify/plugins/pkce/*",
        "libs/fastify/plugins/federation/*",
        "libs/fastify/plugins/signer/*",
        "libs/fastify/plugins/event-delivery/*",
        "libs/fastify/plugins/ssf/*",
        "libs/fastify/plugins/sessions/*",
        "libs/fastify/plugins/realm-policy/*",
        "libs/fastify/plugins/dpop/*",
        "libs/fastify/plugins/egress/*",
        "libs/core/crypto/*",
        "libs/core/crypto-native/*",
        "libs/keys/aws-kms/*",
        "libs/keys/vault/*"
      ]
    },
    {
      "plugin": "@nx/js/typescript",
      "include": [
        "libs/infra/db/*",
        "libs/infra/cache/*",
        "libs/fastify/plugins/db/*",
        "libs/fastify/plugins/cache/*",
        "libs/fastify/plugins/password/*",
        "libs/fastify/plugins/email/*",
        "libs/fastify/plugins/jwt/*",
        "libs/shared/errors/*",
        "libs/server/config/*",
        "libs/server/email/*",
        "libs/server/password/*",
        "libs/shared/validation/*",
        "libs/shared/events/*",
        "libs/shared/stability/*",
        "libs/shared/testing/*",
        "libs/shared/test-vectors/*",
        "libs/shared/interaction-contract/*",
        "libs/shared/interaction-client/*",
        "libs/server/jwt/*",
        "libs/server/pkce/*",
        "libs/server/federation/*",
        "libs/server/keys/*",
        "libs/server/egress/*",
        "libs/server/event-delivery/*",
        "libs/server/ssf/*",
        "libs/server/sessions/*",
        "libs/server/dpop/*",
        "libs/server/realm-policy/*",
        "libs/server/step-grammar/*",
        "libs/fastify/plugins/pkce/*",
        "libs/fastify/plugins/federation/*",
        "libs/fastify/plugins/signer/*",
        "libs/fastify/plugins/event-delivery/*",
        "libs/fastify/plugins/ssf/*",
        "libs/fastify/plugins/sessions/*",
        "libs/fastify/plugins/realm-policy/*",
        "libs/fastify/plugins/dpop/*",
        "libs/fastify/plugins/egress/*",
        "libs/core/crypto/*",
        "libs/core/crypto-native/*",
        "libs/keys/aws-kms/*",
        "libs/keys/vault/*"
      ],
      "options": {
        "compiler": "tsgo",
        "typecheck": {
          "targetName": "typecheck"
        }
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "testMode": "run"
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "previewTargetName": "preview",
        "serveTargetName": "serve",
        "devTargetName": "dev",
        "serveStaticTargetName": "serve-static",
        "typecheckTargetName": "typecheck",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    }
  ],
  "targetDefaults": {
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      // Since Nx 23.2 an esbuild build with generatePackageJson also emits the
      // pruned pnpm deploy output (lockfile plus a settings-only
      // pnpm-workspace.yaml) carrying the root pnpm install settings, which no
      // lockfile records. Hash them, and the pnpm major that decides where they
      // land, so a changed build approval cannot replay a stale output (from
      // @nx/js's update-23-2-0-add-pnpm-deploy-output-cache-inputs migration).
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/pnpm-workspace.yaml",
        {
          "json": "{workspaceRoot}/package.json",
          "fields": [
            "packageManager",
            "pnpm.onlyBuiltDependencies",
            "pnpm.neverBuiltDependencies",
            "pnpm.allowBuilds",
            "pnpm.supportedArchitectures",
            "pnpm.patchedDependencies"
          ]
        },
        {
          "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
        }
      ]
    }
  },
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/.github/workflows/ci.yml",
      // Every project's vitest.config.ts mergeConfig()s the root one, so a
      // change there (exclude globs, coverage thresholds) must invalidate every
      // test target. The @nx/vitest inferred targets do not list it themselves.
      "{workspaceRoot}/vitest.config.ts",
      // Every project tsconfig but the developer portal's extends this one.
      // Nx 23's inferred typecheck targets listed it as an input; Nx 24's hash
      // only `default` and `^default`, so without it a compiler-option change
      // here would replay a cached typecheck pass. Builds and tests read it too.
      "{workspaceRoot}/tsconfig.base.json"
    ],
    // #285: this was `["sharedGlobals"]`, dropping Nx's built-in
    // `{projectRoot}/**/*` entry. Every `default`-hashed target (test, build)
    // therefore hashed only ci.yml and ignored the project's own sources, so a
    // cached green `test` result was replayed even after a failing spec was
    // added. Keep `{projectRoot}/**/*` first — it is what makes a source edit
    // invalidate the task.
    "default": ["{projectRoot}/**/*", "sharedGlobals"]
  },
  "sync": {
    "disabledTaskSyncGenerators": ["@nx/js:typescript-sync"]
  },
  "analytics": false,
  // Nx 24's `nx affected -t` runs only the tasks whose inputs a change
  // reaches, where Nx 23 ran every listed target of each affected project.
  // `legacy: true` keeps the Nx 23 selection that CI's `nx affected` runs were
  // built on, so a target with an incomplete `inputs` list cannot drop out of
  // CI (from nx's 24-0-0-enable-legacy-affected migration). NX_LEGACY_AFFECTED
  // overrides it for a single run.
  "affected": {
    "legacy": true
  },
  // No remote cache: the Nx Cloud workspace was dropped on 31 Oct 2026, when
  // its free plan ran out and the cache had saved little. This keeps `nx`
  // commands (generators, migrations) from connecting the workspace again.
  "neverConnectToCloud": true
}
