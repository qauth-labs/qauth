{
  "name": "qauth",
  "version": "0.0.0",
  "description": "Post-quantum ready, headless-first identity platform. A developer-friendly alternative to Keycloak.",
  "license": "Apache-2.0",
  "author": "QAuth Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/qauth-labs/qauth.git"
  },
  "keywords": [
    "authentication",
    "authorization",
    "oauth2",
    "oidc",
    "sso",
    "identity",
    "security",
    "jwt",
    "keycloak-alternative"
  ],
  "private": true,
  "engines": {
    "node": ">=26.10.0",
    "pnpm": ">=12.14.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "nx serve",
    "build": "nx build",
    "lint": "nx lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "spec-matrix": "node scripts/spec-matrix.mjs --vitest-report dist/vitest-report.json --vitest-report dist/wire-report.json --out-dir dist/conformance",
    "stable-surface": "node scripts/stable-surface/check.mjs",
    "experimental-status": "node scripts/experimental-status.mjs",
    "test": "nx run-many -t test --all",
    "test:watch": "nx run-many -t test --all --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "nx run-many -t test --all --coverage",
    "test:affected": "nx affected -t test",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "**/*.{js,jsx,json,yml,yaml,css,less,scss,ts,tsx,md,graphql}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@nx/esbuild": "catalog:",
    "@nx/eslint": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@nx/js": "catalog:",
    "@nx/node": "catalog:",
    "@nx/oxlint": "catalog:",
    "@nx/react": "catalog:",
    "@nx/vite": "catalog:",
    "@nx/vitest": "catalog:",
    "@nx/web": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "husky": "catalog:",
    "jiti": "catalog:",
    "jsdom": "catalog:",
    "jsonc-eslint-parser": "catalog:",
    "lint-staged": "catalog:",
    "nx": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {}
}
