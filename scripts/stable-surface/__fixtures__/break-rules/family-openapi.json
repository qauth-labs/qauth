{
  "openapi": "3.1.0",
  "info": {
    "title": "Family document fixture",
    "version": "v1-rc.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/developer/v1-rc.0/clients": {
      "get": {
        "operationId": "developer.clients.list",
        "x-qauth-stability": "stable",
        "x-qauth-class": "read",
        "x-qauth-permission": "clients.read",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "dpopAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of clients",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items", "nextCursor"],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Client"
                      }
                    },
                    "nextCursor": {
                      "type": ["string", "null"]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "developer.clients.create",
        "x-qauth-stability": "stable",
        "x-qauth-class": "write",
        "x-qauth-permission": "clients.write",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "dpopAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["client_name"],
                "additionalProperties": false,
                "properties": {
                  "client_name": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "token_endpoint_auth_method": {
                    "type": "string",
                    "enum": ["client_secret_basic", "client_secret_post", "none"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Client"
                }
              }
            }
          }
        }
      }
    },
    "/developer/v1-rc.0/clients/{clientId}": {
      "delete": {
        "operationId": "developer.clients.delete",
        "x-qauth-stability": "stable",
        "x-qauth-class": "write",
        "x-qauth-permission": "clients.write",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "dpopAuth": []
          }
        ],
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "dpopAuth": {
        "type": "http",
        "scheme": "DPoP",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Client": {
        "type": "object",
        "required": ["client_id", "client_name", "created_at"],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "redirect_uris": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "grant_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status", "code"],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "trace_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
