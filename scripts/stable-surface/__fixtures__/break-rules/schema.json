{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/schemas/fixture-event.json",
  "type": "object",
  "required": ["type", "subject"],
  "properties": {
    "type": { "type": "string", "enum": ["user.created", "user.deleted"] },
    "subject": { "$ref": "#/$defs/Subject" },
    "note": { "type": "string" }
  },
  "$defs": {
    "Subject": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string" }, "realm": { "type": "string" } }
    }
  }
}
