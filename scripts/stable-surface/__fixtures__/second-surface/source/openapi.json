{
  "openapi": "3.1.0",
  "info": { "title": "Fixture API", "version": "1" },
  "paths": {
    "/things": {
      "get": {
        "x-qauth-stability": "stable",
        "responses": {
          "200": {
            "description": "A thing",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "id": { "type": "string" }, "name": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    }
  }
}
