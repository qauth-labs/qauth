{
  "schema": "qauth-vectors/1",
  "id": "jwt/access-token",
  "description": "Access token checks a resource server runs on a QAuth JWT access token (RFC 9068 §4). input.token is a compact JWS signed with EdDSA (Ed25519). Select the key from input.jwks by the token header's kid, accept only EdDSA, and verify with input.now (Unix seconds) as the current time; the expected issuer is input.issuer and the expected audience is input.audience. Every case gives the same result with any clock tolerance from 0 to 60 seconds. expected.valid says whether the token passes; a valid token's expected.claims is its verified payload; an invalid token's expected.reason names the one check it fails: \"typ\" (the header typ is not at+jwt), \"iss\", \"aud\", \"exp\" or \"signature\". Each case is wrong in exactly one way. The JWKS holds a throwaway test key, generated from a fixed seed for this file.",
  "source": "RFC 9068 §4 (validating JWT access tokens); generated by test-vectors/generators/access-token.mjs with Node.js node:crypto",
  "cases": [
    {
      "id": "valid",
      "input": {
        "token": "eyJhbGciOiJFZERTQSIsInR5cCI6ImF0K2p3dCIsImtpZCI6InRocm93YXdheS10ZXN0LWVkMjU1MTktMSJ9..FTXRt-GmTUG-6qcWy5IY2KNnpJ01jHEdnU9FvHvnZqJjkV9SPjjPLR2emfuUnQr5zyUpHOZLxCjtCZDZafSrCw",
        "jwks": {
          "keys": [
            {
              "kty": "OKP",
              "crv": "Ed25519",
              "x": "8eUpDxIZwzTK7C3o5pG5b-Y-NNpWRvMgxWD3ctOnvTM",
              "kid": "throwaway-test-ed25519-1",
              "alg": "EdDSA",
              "use": "sig"
            }
          ]
        },
        "now": 1767225600,
        "issuer": "https://as.example.com",
        "audience": "https://rs.example.com"
      },
      "expected": {
        "valid": true,
        "claims": {
          "iss": "https://as.example.com",
          "sub": "user-0001",
          "aud": "https://rs.example.com",
          "client_id": "client-0001",
          "scope": "notes:read",
          "iat": 1767225540,
          "exp": 1767226440,
          "jti": "0199f2b4-0000-7000-8000-000000000001",
          "token_use": "access"
        }
      },
      "notes": "Passes every check. claims is the whole verified payload."
    },
    {
      "id": "wrong-issuer",
      "input": {
        "token": "eyJhbGciOiJFZERTQSIsInR5cCI6ImF0K2p3dCIsImtpZCI6InRocm93YXdheS10ZXN0LWVkMjU1MTktMSJ9..s7mX-hR1XPezSGp5AFuO1vcsIpJSGFpxei9UwLoRHcA-BKGkqxSbFXLtzhxxTn3PiOjoa0p_Q6O6B6AmNyG8Dg",
        "jwks": {
          "keys": [
            {
              "kty": "OKP",
              "crv": "Ed25519",
              "x": "8eUpDxIZwzTK7C3o5pG5b-Y-NNpWRvMgxWD3ctOnvTM",
              "kid": "throwaway-test-ed25519-1",
              "alg": "EdDSA",
              "use": "sig"
            }
          ]
        },
        "now": 1767225600,
        "issuer": "https://as.example.com",
        "audience": "https://rs.example.com"
      },
      "expected": {
        "valid": false,
        "reason": "iss"
      },
      "notes": "RFC 9068 §4 step 3: iss must be the expected issuer."
    },
    {
      "id": "wrong-audience",
      "input": {
        "token": "eyJhbGciOiJFZERTQSIsInR5cCI6ImF0K2p3dCIsImtpZCI6InRocm93YXdheS10ZXN0LWVkMjU1MTktMSJ9..dQup8e5CUWtF9-ynSi1aU7Ps73y2uJ1mJkNVvLZqcjev_H2Tp4hOxlCVdFQ2sVKGhz3gDOU_jDc7CB2tqIkxBg",
        "jwks": {
          "keys": [
            {
              "kty": "OKP",
              "crv": "Ed25519",
              "x": "8eUpDxIZwzTK7C3o5pG5b-Y-NNpWRvMgxWD3ctOnvTM",
              "kid": "throwaway-test-ed25519-1",
              "alg": "EdDSA",
              "use": "sig"
            }
          ]
        },
        "now": 1767225600,
        "issuer": "https://as.example.com",
        "audience": "https://rs.example.com"
      },
      "expected": {
        "valid": false,
        "reason": "aud"
      },
      "notes": "RFC 9068 §4 step 4: aud must contain this resource server."
    },
    {
      "id": "expired",
      "input": {
        "token": "eyJhbGciOiJFZERTQSIsInR5cCI6ImF0K2p3dCIsImtpZCI6InRocm93YXdheS10ZXN0LWVkMjU1MTktMSJ9..QK_WlpucQ8_HhQeOLQMSop9dwYyvvVACgxwXjvrzcm4JNuP5352qWTDkvtfUrDS3sW6SHbvNVFzjQOmNR5UMAA",
        "jwks": {
          "keys": [
            {
              "kty": "OKP",
              "crv": "Ed25519",
              "x": "8eUpDxIZwzTK7C3o5pG5b-Y-NNpWRvMgxWD3ctOnvTM",
              "kid": "throwaway-test-ed25519-1",
              "alg": "EdDSA",
              "use": "sig"
            }
          ]
        },
        "now": 1767225600,
        "issuer": "https://as.example.com",
        "audience": "https://rs.example.com"
      },
      "expected": {
        "valid": false,
        "reason": "exp"
      },
      "notes": "RFC 9068 §4 step 6: expired an hour before now."
    },
    {
      "id": "wrong-typ",
      "input": {
        "token": "eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCIsImtpZCI6InRocm93YXdheS10ZXN0LWVkMjU1MTktMSJ9..F_OynsSS3AltuCmz7M1Q9JkFW3HXHZBfUoP79bEX8zpPyrUsCgSuCvnJWt1uvG8US5iDEn3PZY_hOQScoyAKCw",
        "jwks": {
          "keys": [
            {
              "kty": "OKP",
              "crv": "Ed25519",
              "x": "8eUpDxIZwzTK7C3o5pG5b-Y-NNpWRvMgxWD3ctOnvTM",
              "kid": "throwaway-test-ed25519-1",
              "alg": "EdDSA",
              "use": "sig"
            }
          ]
        },
        "now": 1767225600,
        "issuer": "https://as.example.com",
        "audience": "https://rs.example.com"
      },
      "expected": {
        "valid": false,
        "reason": "typ"
      },
      "notes": "RFC 9068 §4 step 1: typ is JWT, the typ of a QAuth ID token signed with the same key, not at+jwt."
    },
    {
      "id": "bad-signature",
      "input": {
        "token": "eyJhbGciOiJFZERTQSIsInR5cCI6ImF0K2p3dCIsImtpZCI6InRocm93YXdheS10ZXN0LWVkMjU1MTktMSJ9..JzrWCWBIGJZx-f_qO47g4761gvXLZSpr0pdkJH85NRntzfXPzvtsh9VdRmj4larTpWNdZdZgtcsJdzdmU-cUBg",
        "jwks": {
          "keys": [
            {
              "kty": "OKP",
              "crv": "Ed25519",
              "x": "8eUpDxIZwzTK7C3o5pG5b-Y-NNpWRvMgxWD3ctOnvTM",
              "kid": "throwaway-test-ed25519-1",
              "alg": "EdDSA",
              "use": "sig"
            }
          ]
        },
        "now": 1767225600,
        "issuer": "https://as.example.com",
        "audience": "https://rs.example.com"
      },
      "expected": {
        "valid": false,
        "reason": "signature"
      },
      "notes": "RFC 9068 §4 step 5: signed by another key under the same kid, so the JWKS key does not verify it."
    }
  ]
}
